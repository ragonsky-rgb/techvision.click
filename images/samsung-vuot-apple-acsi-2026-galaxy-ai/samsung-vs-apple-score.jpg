<style>
	.menu { position: sticky; top: -1px; width: 100%; height: 60px; text-align: center; z-index: 1000; background-color: rgba(255, 255, 255, 0.96); border-bottom: 0px; }
	
	.menu_items { display: inline-block; text-align: justify; }
