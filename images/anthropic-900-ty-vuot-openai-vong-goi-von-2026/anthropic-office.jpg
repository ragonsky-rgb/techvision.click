.tmb-preipo-metric-sub { font-size: 12px; color: #556380; margin-top: 2px; }
.tmb-preipo-metric-warn { color: #FF5C5C !important; }
.tmb-preipo-status-active { color: #00E59B !important; font-size: 15px !important; }
.tmb-preipo-status-exploring { color: #FFB547 !important; font-size: 15px !important; }
.tmb-preipo-status-early { color: #8896B0 !important; font-size: 15px !important; }
.tmb-preipo-card-expand-hint { margin-top: 16px; text-align: center; font-size: 12px; color: #556380; transition: all 0.2s; padding-top: 12px; border-top: 1px solid rgba(27,36,54,0.5); }
.tmb-preipo-card:hover .tmb-preipo-card-expand-hint { color: #A78BFA; }
.expand-icon { display: inline-block; transition: transform 0.3s ease; font-size: 10px; margin-right: 4px; }
.tmb-preipo-card.expanded .expand-icon { transform: rotate(180deg); }
.tmb-preipo-card-details { max-height: 0; overflow: hidden; transition: max-height 0.4s ease, padding 0.3s ease; padding: 0 24px; border-top: 0px solid transparent; }
.tmb-preipo-card.expanded .tmb-preipo-card-details { max-height: 2000px; padding: 0 24px 24px; border-top: 1px solid #1b2436; }
.tmb-preipo-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-top: 20px; }
.tmb-preipo-detail-block h4 { color: #A78BFA !important; font-size: 13px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.06em !important; margin: 0 0 10px !important; font-family: 'DM Sans', sans-serif !important; }
.tmb-preipo-detail-block p { font-size: 14px !important; color: #8896B0 !important; line-height: 1.65 !important; margin: 0 !important; }
.tmb-preipo-detail-block ul { list-style: none; padding: 0; margin: 0; }
.tmb-preipo-detail-block li { font-size: 14px; color: #8896B0; line-height: 1.6; padding: 4px 0 4px 16px; position: relative; }
.tmb-preipo-detail-block li::before { content: ''; position: absolute; left: 0; top: 12px; width: 6px; height: 6px; border-radius: 50%; background: #A78BFA; }
.tmb-preipo-detail-block strong { color: #F0F4FC; font-weight: 600; }
.tmb-preipo-detail-table { width: 100%; border-collapse: collapse; }
.tmb-preipo-detail-table td { padding: 8px 0 !important; border-bottom: 1px solid rgba(27,36,54,0.5) !important; font-size: 14px !important; vertical-align: top !important; }
.tmb-preipo-detail-table tr:last-child td { border-bottom: none !important; }
.tmb-preipo-detail-table td:first-child { color: #556380 !important; font-weight: 600 !important; width: 40%; white-space: nowrap; padding-right: 12px !important; }
.tmb-preipo-detail-table td:last-child { color: #D6DEF0 !important; }
.tmb-preipo-explainer { background: linear-gradient(135deg, rgba(167,139,250,0.04) 0%, transparent 100%); border: 1px solid #1b2436; border-radius: 16px; padding: 32px; }
.tmb-preipo-explainer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.tmb-preipo-explainer-item { background: rgba(0,0,0,0.25); border-radius: 10px; padding: 20px; }
.tmb-preipo-explainer-item h4 { color: #F0F4FC !important; font-size: 16px !important; font-weight: 600 !important; margin: 0 0 10px !important; font-family: 'Space Grotesk', sans-serif !important; }
.tmb-preipo-explainer-item p { color: #8896B0 !important; font-size: 14px !important; line-height: 1.6 !important; margin: 0 !important; }
.tmb-preipo-faq { display: grid; gap: 12px; }
.tmb-preipo-faq-item { background: #0d1117; border: 1px solid #1b2436; border-radius: 10px; padding: 20px; }
.tmb-preipo-faq-item h4 { color: #F0F4FC !important; font-size: 16px !important; font-weight: 600 !important; margin: 0 0 10px !important; font-family: 'Space Grotesk', sans-serif !important; }
.tmb-preipo-faq-item p { color: #8896B0 !important; font-size: 14px !important; line-height: 1.65 !important; margin: 0 !important; }
.tmb-preipo-faq-item strong { color: #F0F4FC; }
@media (max-width: 900px) { .tmb-preipo-card-metrics { grid-template-columns: repeat(2, 1fr); } .tmb-preipo-explainer-grid { grid-template-columns: repeat(2, 1fr); } .tmb-preipo-detail-grid { grid-template-columns: 1fr; } }
@media (max-width: 768px) { .tmb-preipo { padding: 0 16px; } .tmb-preipo-hero { padding: 32px 0 28px; } .tmb-preipo-hero h1 { font-size: 28px !important; } .tmb-preipo-hero p { font-size: 16px; } .tmb-preipo-hero-stats { gap: 24px; flex-wrap: wrap; } .tmb-preipo-hero-stat-value { font-size: 28px; } .tmb-preipo-card-header { padding: 16px; } .tmb-preipo-card-title-row { flex-direction: column; } .tmb-preipo-card-metrics { grid-template-columns: 1fr 1fr; gap: 8px; } .tmb-preipo-metric-value { font-size: 15px; } .tmb-preipo-card.expanded .tmb-preipo-card-details { padding: 0 16px 16px; } .tmb-preipo-explainer { padding: 20px; } .tmb-preipo-explainer-grid { grid-template-columns: 1fr; } }
.tmb-preipo-card-metrics > p, .tmb-preipo-detail-grid > p, .tmb-preipo-explainer-grid > p, .tmb-preipo-faq > p, .tmb-preipo-hero-stats > p { display: none !important; }  /* ═══════════════════════════════════════
 PRE-IPO INDEX PAGE v2
 ═══════════════════════════════════════ */
.tmb-preipo-summary { color: #8896B0; font-size: 15px; line-height: 1.7; max-width: 700px; margin: 20px auto 0; text-align: center; }
.tmb-preipo-filter-bar { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 40px; }
.tmb-preipo-filter-btn { font-family: 'DM Sans', sans-serif !important; font-size: 13px !important; font-weight: 600 !important; padding: 7px 16px !important; border-radius: 6px !important; border: 1px solid #1b2436 !important; background: transparent !important; color: #8896B0 !important; cursor: pointer !important; transition: all 0.2s ease !important; text-transform: none !important; letter-spacing: 0 !important; }
.tmb-preipo-filter-btn:hover { border-color: #2a3650 !important; color: #F0F4FC !important; background: rgba(255,255,255,0.03) !important; transform: none !important; }
.tmb-preipo-filter-btn.active { border-color: #A78BFA !important; color: #A78BFA !important; background: rgba(167,139,250,0.1) !important; }
.tmb-preipo-sector-group { margin-bottom: 40px; }
.tmb-preipo-sector-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.tmb-preipo-sector-title { font-family: 'Space Grotesk', sans-serif !important; font-size: 20px !important; font-weight: 600 !important; color: #F0F4FC !important; margin: 0 !important; text-transform: none !important; }
.tmb-preipo-sector-count { font-size: 13px; color: #556380; font-family: 'DM Mono', monospace; }
.tmb-preipo-card-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
.tmb-preipo-link-card { display: block; text-decoration: none !important; color: inherit; background: #0d1117; border: 1px solid #1b2436; border-radius: 14px; padding: 24px; transition: all 0.25s ease; position: relative; overflow: hidden; }
.tmb-preipo-link-card:hover { border-color: rgba(167,139,250,0.3); transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
.tmb-preipo-link-card-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 6px; gap: 8px; }
.tmb-preipo-link-card-name { font-family: 'Space Grotesk', sans-serif; font-size: 20px; font-weight: 600; color: #F0F4FC; }
.tmb-preipo-ipo-badge { font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500; padding: 4px 10px; border-radius: 6px; white-space: nowrap; flex-shrink: 0; }
.tmb-preipo-ipo-badge.badge-imminent { background: rgba(0,229,155,0.12); color: #00E59B; border: 1px solid rgba(0,229,155,0.25); }
.tmb-preipo-ipo-badge.badge-likely { background: rgba(91,156,255,0.12); color: #5B9CFF; border: 1px solid rgba(91,156,255,0.2); }
.tmb-preipo-ipo-badge.badge-possible { background: rgba(167,139,250,0.12); color: #A78BFA; border: 1px solid rgba(167,139,250,0.2); }
.tmb-preipo-ipo-badge.badge-early { background: rgba(255,181,71,0.12); color: #FFB547; border: 1px solid rgba(255,181,71,0.2); }
.tmb-preipo-link-card-badges { display: flex; gap: 6px; margin: 10px 0 14px; }
.tmb-preipo-link-card-tagline { font-size: 14px; color: #8896B0; line-height: 1.55; margin-bottom: 18px; }
.tmb-preipo-link-card-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding-top: 16px; border-top: 1px solid rgba(27,36,54,0.6); }
.tmb-preipo-link-metric-label { font-size: 11px; color: #556380; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 2px; }
.tmb-preipo-link-metric-value { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 600; color: #F0F4FC; }
.tmb-preipo-link-metric-value.val-accent { color: #A78BFA; }
.tmb-preipo-link-card-cta { position: absolute; bottom: 24px; right: 24px; font-size: 12px; font-family: 'DM Sans', sans-serif; font-weight: 600; color: #556380; transition: all 0.2s; }
.tmb-preipo-link-card:hover .tmb-preipo-link-card-cta { color: #A78BFA; transform: translateX(3px); }
.tmb-preipo-coming-soon { background: rgba(0,0,0,0.2); border: 1px dashed #1b2436; border-radius: 14px; padding: 32px; text-align: center; margin-bottom: 48px; }
.tmb-preipo-coming-soon-label { font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 700; color: #556380; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
.tmb-preipo-coming-soon-chips { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
.tmb-preipo-coming-chip { font-family: 'DM Mono', monospace; font-size: 13px; padding: 6px 14px; border-radius: 6px; background: rgba(0,0,0,0.25); color: #8896B0; border: 1px solid #1b2436; }
.tmb-preipo-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.tmb-preipo-feature-card { background: #0d1117; border: 1px solid #1b2436; border-radius: 10px; padding: 20px; }
.tmb-preipo-feature-num { width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; font-family: 'DM Mono', monospace; font-size: 13px; font-weight: 500; background: rgba(167,139,250,0.1); color: #A78BFA; }
.tmb-preipo-feature-name { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 600; color: #F0F4FC; margin-bottom: 6px; }
.tmb-preipo-feature-desc { font-size: 13px; color: #8896B0; line-height: 1.5; }
.tmb-preipo-exposure-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.tmb-preipo-exposure-card { background: #0d1117; border: 1px solid #1b2436; border-radius: 10px; padding: 24px; }
.tmb-preipo-exposure-num { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; background: rgba(0,0,0,0.25); color: #556380; border: 1px solid #1b2436; }
.tmb-preipo-exposure-title { font-family: 'Space Grotesk', sans-serif !important; font-size: 16px !important; font-weight: 600 !important; color: #F0F4FC !important; margin: 0 0 10px !important; }
.tmb-preipo-exposure-text { font-size: 14px !important; color: #8896B0 !important; line-height: 1.6 !important; margin: 0 !important; }
.tmb-preipo-exposure-text strong { color: #F0F4FC; font-weight: 600; }
.tmb-preipo-faq-accordion { display: grid; gap: 0; }
.tmb-preipo-faq-acc-item { border-bottom: 1px solid #1b2436; padding: 0; }
.tmb-preipo-faq-acc-item:first-child { border-top: 1px solid #1b2436; }
.tmb-preipo-faq-acc-btn { font-family: 'Space Grotesk', sans-serif !important; font-size: 16px !important; font-weight: 600 !important; color: #F0F4FC !important; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; background: none !important; border: none !important; width: 100%; text-align: left; padding: 20px 0 !important; border-radius: 0 !important; text-transform: none !important; letter-spacing: 0 !important; transition: color 0.2s !important; transform: none !important; }
.tmb-preipo-faq-acc-btn:hover { color: #A78BFA !important; background: none !important; transform: none !important; }
.tmb-preipo-faq-acc-toggle { font-size: 18px; color: #556380; flex-shrink: 0; transition: color 0.2s; line-height: 1; }
.tmb-preipo-faq-acc-item.open .tmb-preipo-faq-acc-toggle { color: #A78BFA; }
.tmb-preipo-faq-acc-answer { font-size: 14px !important; color: #8896B0 !important; line-height: 1.7 !important; margin: 0 0 20px !important; max-width: 720px; display: none; }
.tmb-preipo-faq-acc-item.open .tmb-preipo-faq-acc-answer { display: block; }
.tmb-preipo-request { background: linear-gradient(135deg, rgba(167,139,250,0.04) 0%, transparent 100%); border: 1px solid #1b2436; border-radius: 14px; padding: 40px; text-align: center; margin-bottom: 48px; }
.tmb-preipo-request h3 { font-family: 'Space Grotesk', sans-serif !important; font-size: 20px !important; font-weight: 600 !important; color: #F0F4FC !important; margin: 0 0 10px !important; }
.tmb-preipo-request p { font-size: 14px !important; color: #8896B0 !important; margin: 0 0 20px !important; }
.tmb-preipo-request-btn { display: inline-block !important; font-family: 'DM Sans', sans-serif !important; font-size: 13px !important; font-weight: 700 !important; padding: 10px 24px !important; border-radius: 8px !important; background: #A78BFA !important; color: #06090F !important; text-decoration: none !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; transition: all 0.2s ease !important; }
.tmb-preipo-request-btn:hover { background: #9678f0 !important; transform: translateY(-1px) !important; color: #06090F !important; }
.tmb-preipo-author { padding: 32px 0 0; border-top: 1px solid #1b2436; margin-bottom: 32px; }
.tmb-preipo-author-label { font-size: 12px; font-family: 'DM Sans', sans-serif; font-weight: 700; color: #556380; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; }
.tmb-preipo-author-card { display: flex; gap: 20px; align-items: flex-start; }
.tmb-preipo-author-avatar { width: 56px; height: 56px; border-radius: 50%; border: 2px solid #1b2436; flex-shrink: 0; }
.tmb-preipo-author-name { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 600; color: #F0F4FC; margin-bottom: 6px; }
.tmb-preipo-author-bio { font-size: 14px !important; color: #8896B0 !important; line-height: 1.6 !important; margin: 0 0 10px !important; }
.tmb-preipo-author-links { display: flex; gap: 16px; font-size: 13px; }
.tmb-preipo-author-links a { color: #A78BFA !important; text-decoration: none !important; }
.tmb-preipo-author-links a:hover { color: #9678f0 !important; text-decoration: underline !important; }
.tmb-preipo-editorial { font-size: 13px !important; color: #556380 !important; font-style: italic; margin-top: 16px !important; }
@media (max-width: 900px) { .tmb-preipo-features-grid { grid-template-columns: repeat(2, 1fr); } .tmb-preipo-exposure-grid { grid-template-columns: 1fr; } }
@media (max-width: 768px) { .tmb-preipo-card-grid { grid-template-columns: 1fr; } .tmb-preipo-features-grid { grid-template-columns: 1fr 1fr; } .tmb-preipo-link-card-metrics { grid-template-columns: 1fr 1fr; } .tmb-preipo-link-card-cta { display: none; } }
@media (max-width: 480px) { .tmb-preipo-features-grid { grid-template-columns: 1fr; } .tmb-preipo-link-card-metrics { grid-template-columns: 1fr; } }
.tmb-preipo-card-grid > p, .tmb-preipo-features-grid > p, .tmb-preipo-exposure-grid > p, .tmb-preipo-coming-soon-chips > p, .tmb-preipo-filter-bar > p, .tmb-preipo-faq-accordion > p { display: none !important; }
.page-id-3427 .tmb-preipo-exposure-text a, .page-id-3427 .tmb-preipo-faq-acc-answer a { color: #A78BFA !important; text-decoration: underline !important; text-decoration-color: rgba(167,139,250,0.4) !important; text-underline-offset: 3px !important; }
.page-id-3427 .tmb-preipo-exposure-text a:hover, .page-id-3427 .tmb-preipo-faq-acc-answer a:hover { text-decoration-color: #A78BFA !important; color: #9678f0 !important; }
.tmb-preipo-card-logo { width: 32px; height: 32px; object-fit: contain; flex-shrink: 0; border-radius: 6px; }
.tmb-preipo-link-card-name-row { display: flex; align-items: center; gap: 10px; }
@media (max-width: 480px) { .tmb-preipo-card-logo { width: 28px; height: 28px; } }  /* ═══════════════════════════════════════
 SECTOR PAGES — GP OVERRIDES
 ═══════════════════════════════════════ */
.page-id-3435 .site-content, .page-id-3434 .site-content, .page-id-3438 .site-content, .page-id-3440 .site-content, .page-id-3442 .site-content, .page-id-3444 .site-content { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }
.page-id-3435 .content-area, .page-id-3434 .content-area, .page-id-3438 .content-area, .page-id-3440 .content-area, .page-id-3442 .content-area, .page-id-3444 .content-area { max-width: 100% !important; padding: 0 !important; width: 100% !important; }
.page-id-3435 .entry-content, .page-id-3434 .entry-content, .page-id-3438 .entry-content, .page-id-3440 .entry-content, .page-id-3442 .entry-content, .page-id-3444 .entry-content { max-width: 100% !important; padding: 0 !important; margin: 0 auto !important; }
.page-id-3435 .entry-header, .page-id-3434 .entry-header, .page-id-3438 .entry-header, .page-id-3440 .entry-header, .page-id-3442 .entry-header, .page-id-3444 .entry-header { display: none !important; }
.page-id-3435 #right-sidebar, .page-id-3434 #right-sidebar, .page-id-3438 #right-sidebar, .page-id-3440 #right-sidebar, .page-id-3442 #right-sidebar, .page-id-3444 #right-sidebar { display: none !important; }
.tmb-sector .tmb-sector-stats, .tmb-sector .tmb-sector-profiles-grid, .tmb-sector .tmb-sector-themes-grid, .tmb-sector .tmb-sector-coming-grid { display: flex !important; }  /* ═══════════════════════════════════════
 INDIVIDUAL SECTOR PAGE STYLES
 Scale: 28 / 18 / 16 / 14  |  All white  |  No greys
 ═══════════════════════════════════════ */
.tmb-sector { background: #0d1117; color: #F0F4FC; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; }
/* Hero */
.tmb-sector-hero { background: linear-gradient(135deg, #0d1117 0%, #161b22 50%, #0d1117 100%); border-bottom: 1px solid #21262d; padding: 60px 20px 50px; text-align: center; position: relative; overflow: hidden; }
.tmb-sector-hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, var(--sector-accent), transparent); }
.tmb-sector-hero-label { display: inline-block; font-size: 14px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--sector-accent); border: 1px solid var(--sector-accent); border-radius: 4px; padding: 4px 14px; margin-bottom: 20px; }
.tmb-sector-hero h1 { font-size: 28px; font-weight: 800; color: #F0F4FC; margin: 0 0 16px; line-height: 1.2; }
.tmb-sector-hero h1 span { color: var(--sector-accent); }
.tmb-sector-hero-desc { font-size: 16px; color: #F0F4FC; max-width: 650px; margin: 0 auto; line-height: 1.6; }
/* Stats bar */
.tmb-sector-stats { display: flex; justify-content: center; gap: 0; background: #161b22; border-bottom: 1px solid #21262d; padding: 0; flex-wrap: wrap; }
.tmb-sector-stats-item { padding: 20px 32px; text-align: center; border-right: 1px solid #21262d; flex: 1; min-width: 140px; max-width: 220px; }
.tmb-sector-stats-item:last-child { border-right: none; }
.tmb-sector-stats-value { font-size: 28px; font-weight: 800; color: var(--sector-accent); display: block; }
.tmb-sector-stats-label { font-size: 14px; color: #F0F4FC; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; display: block; }
/* Content container */
.tmb-sector-content { max-width: 1100px; margin: 0 auto; padding: 50px 20px 60px; }
/* Section headings — 18px */
.tmb-sector-section-title { font-size: 18px; font-weight: 700; color: #F0F4FC; margin: 0 0 8px; display: flex; align-items: center; gap: 10px; }
.tmb-sector-section-title::before { content: ''; width: 4px; height: 22px; background: var(--sector-accent); border-radius: 2px; flex-shrink: 0; }
.tmb-sector-section-desc { font-size: 16px; color: #F0F4FC; margin: 0 0 28px; padding-left: 14px; }
/* Overview — 16px body */
.tmb-sector-overview { margin-bottom: 50px; }
.tmb-sector-overview p { color: #F0F4FC; font-size: 16px; line-height: 1.7; margin: 0 0 16px; }
.tmb-sector-overview p:last-child { margin-bottom: 0; }
/* Company profile cards */
.tmb-sector-profiles-grid { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 50px; }
.tmb-sector-card { background: #161b22; border: 1px solid #21262d; border-radius: 10px; padding: 24px; flex: 1 1 calc(50% - 10px); min-width: 280px; max-width: calc(50% - 10px); transition: border-color 0.2s ease, transform 0.2s ease; text-decoration: none; display: block; cursor: pointer; }
.tmb-sector-card:hover { border-color: var(--sector-accent); transform: translateY(-2px); }
.tmb-sector-card-header { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
.tmb-sector-card-logo { width: 32px; height: 32px; object-fit: contain; border-radius: 6px; flex-shrink: 0; }
.tmb-sector-card-ticker { background: rgba(var(--sector-accent-rgb), 0.12); color: var(--sector-accent); font-size: 14px; font-weight: 700; letter-spacing: 0.05em; padding: 5px 10px; border-radius: 5px; flex-shrink: 0; }
.tmb-sector-card-name { font-size: 18px; font-weight: 700; color: #F0F4FC; }
.tmb-sector-card-desc { font-size: 16px; color: #F0F4FC; line-height: 1.5; margin-bottom: 16px; }
.tmb-sector-card-link { font-size: 14px; font-weight: 600; color: var(--sector-accent); display: inline-flex; align-items: center; gap: 6px; }
.tmb-sector-card-link::after { content: '→'; transition: transform 0.2s ease; }
.tmb-sector-card:hover .tmb-sector-card-link::after { transform: translateX(4px); }
/* Coming soon */
.tmb-sector-coming { margin-bottom: 50px; }
.tmb-sector-coming-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.tmb-sector-coming-ticker { background: #161b22; border: 1px solid #21262d; border-radius: 6px; padding: 8px 16px; font-size: 14px; font-weight: 600; color: #F0F4FC; letter-spacing: 0.03em; }
/* Key themes */
.tmb-sector-themes { margin-bottom: 50px; }
.tmb-sector-themes-grid { display: flex; flex-wrap: wrap; gap: 16px; }
.tmb-sector-theme-card { background: #161b22; border: 1px solid #21262d; border-left: 3px solid var(--sector-accent); border-radius: 0 8px 8px 0; padding: 20px 24px; flex: 1 1 calc(50% - 8px); min-width: 260px; }
.tmb-sector-theme-title { font-size: 18px; font-weight: 700; color: #F0F4FC; margin: 0 0 8px; }
.tmb-sector-theme-text { font-size: 16px; color: #F0F4FC; line-height: 1.5; margin: 0; }
/* Latest coverage */
.tmb-sector-latest { background: #161b22; border: 1px dashed #30363d; border-radius: 10px; padding: 40px; text-align: center; margin-bottom: 50px; }
.tmb-sector-latest-icon { font-size: 2rem; margin-bottom: 12px; }
.tmb-sector-latest-title { font-size: 18px; font-weight: 700; color: #F0F4FC; margin: 0 0 8px; }
.tmb-sector-latest-text { font-size: 16px; color: #F0F4FC; margin: 0; }
/* FAQ */
.tmb-sector-faq { margin-bottom: 20px; }
.tmb-sector-faq-item { background: #161b22; border: 1px solid #21262d; border-radius: 8px; margin-bottom: 12px; overflow: hidden; }
.tmb-sector-faq-q { padding: 18px 24px; font-size: 18px; font-weight: 600; color: #F0F4FC; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; user-select: none; }
.tmb-sector-faq-q:hover { color: var(--sector-accent); }
.tmb-sector-faq-icon { font-size: 18px; color: #F0F4FC; transition: transform 0.3s ease; flex-shrink: 0; }
.tmb-sector-faq-item.open .tmb-sector-faq-icon { transform: rotate(45deg); color: var(--sector-accent); }
.tmb-sector-faq-a { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
.tmb-sector-faq-item.open .tmb-sector-faq-a { max-height: 500px; }
.tmb-sector-faq-a-inner { padding: 0 24px 20px; font-size: 16px; color: #F0F4FC; line-height: 1.6; border-top: 1px solid #21262d; padding-top: 16px; }
/* Cross-links */
.tmb-sector-crosslinks { background: #161b22; border-top: 1px solid #21262d; padding: 40px 20px; text-align: center; }
.tmb-sector-crosslinks-title { font-size: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #F0F4FC; margin: 0 0 20px; }
.tmb-sector-crosslinks-grid { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; max-width: 800px; margin: 0 auto; }
.tmb-sector-crosslink { background: #0d1117; border: 1px solid #21262d; border-radius: 8px; padding: 12px 20px; color: #F0F4FC; text-decoration: none; font-size: 16px; font-weight: 600; transition: border-color 0.2s ease, color 0.2s ease; }
.tmb-sector-crosslink:hover { border-color: #00E59B; color: #00E59B; }
.tmb-sector-crosslink.current { border-color: var(--sector-accent); color: var(--sector-accent); pointer-events: none; }
/* Last updated line */
.tmb-sector-updated { font-size: 14px; color: #F0F4FC; text-align: center; margin-top: -8px; }
@media (max-width: 768px) {
 .tmb-sector-hero { padding: 40px 16px 36px; }
 .tmb-sector-hero h1 { font-size: 24px; }
 .tmb-sector-stats-item { flex: 1 1 50%; min-width: auto; max-width: none; padding: 16px; border-bottom: 1px solid #21262d; }
 .tmb-sector-stats-item:nth-child(odd) { border-right: 1px solid #21262d; }
 .tmb-sector-stats-item:nth-child(even) { border-right: none; }
 .tmb-sector-stats-item:nth-last-child(-n+2) { border-bottom: none; }
 .tmb-sector-stats-value { font-size: 24px; }
 .tmb-sector-content { padding: 36px 16px 40px; }
 .tmb-sector-card { flex: 1 1 100%; max-width: 100%; }
 .tmb-sector-theme-card { flex: 1 1 100%; }
 .tmb-sectors-hub-card-content { padding: 20px; }
 .tmb-sectors-hub-card-meta { flex-direction: column; align-items: flex-start; gap: 6px; }
 .tmb-sector-latest { padding: 30px 20px; }
}
@media (max-width: 480px) {
 .tmb-sector-hero h1 { font-size: 22px; }
 .tmb-sector-stats-item { padding: 12px; }
 .tmb-sector-stats-value { font-size: 22px; }
 .tmb-sector-faq-q { padding: 14px 16px; font-size: 16px; }
 .tmb-sector-faq-a-inner { padding: 0 16px 16px; }
 .tmb-sector-crosslink { padding: 10px 14px; }
}  /* ═══════════════════════════════════════
 SECTORS HUB PAGE (/sectors/ — ID 3435)
 Scale: 28 / 18 / 16 / 14
 All text white. No greys.
 ═══════════════════════════════════════ */
/* Container & override global underlines */
.page-id-3435 .entry-content { max-width: 1100px !important; margin: 0 auto !important; padding: 0 32px !important; }
.page-id-3435 .entry-content a { text-decoration: none !important; }
.page-id-3435 .entry-content .tmb-sectors-hub-card-border p,
.page-id-3435 .entry-content .tmb-feature-card p,
.page-id-3435 .entry-content .tmb-more-card p,
.page-id-3435 .entry-content .tmb-faq-answer p { font-size: inherit !important; line-height: inherit !important; color: inherit !important; }
@media (max-width: 768px) { .page-id-3435 .entry-content { padding: 0 16px !important; } }
/* Hero */
.tmb-sectors-hero { text-align: center; padding: 48px 20px 40px; border-bottom: 1px solid #1b2436; margin-bottom: 40px; }
.tmb-sectors-label { font-family: var(--tmb-font-body) !important; font-size: 14px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.12em !important; color: #00E59B !important; margin-bottom: 16px !important; display: inline-block !important; border: 1px solid #00E59B !important; border-radius: 4px !important; padding: 4px 14px !important; }
.tmb-sectors-subtitle { font-size: 16px !important; color: #F0F4FC !important; max-width: 700px; margin: 0 auto !important; line-height: 1.6 !important; }
/* Stats row */
.tmb-sectors-stats { display: flex; justify-content: center; gap: 48px; margin: 32px 0 24px; flex-wrap: wrap; }
.tmb-stat-item { text-align: center; }
.tmb-stat-number { display: block; font-family: var(--tmb-font-heading) !important; font-size: 28px !important; font-weight: 700 !important; color: #00E59B !important; }
.tmb-stat-label { display: block; font-size: 14px !important; color: #F0F4FC !important; text-transform: uppercase !important; letter-spacing: 0.08em !important; margin-top: 4px; }
/* ── KILL GREEN LINK INHERITANCE ── */
.page-id-3435 a.tmb-sectors-hub-card {
 color: #F0F4FC !important;
 text-decoration: none !important;
}
.page-id-3435 a.tmb-more-card {
 color: #F0F4FC !important;
 text-decoration: none !important;
}
/* Sector cards — layout */
.page-id-3435 .tmb-sectors-hub-card { display: block !important; background: #0d1117 !important; border: 1px solid #1b2436 !important; border-radius: 14px !important; margin-bottom: 16px !important; transition: border-color 0.25s ease, transform 0.25s ease !important; overflow: hidden !important; }
.page-id-3435 .tmb-sectors-hub-card:hover { border-color: #2a3650 !important; transform: translateY(-2px) !important; }
.tmb-sectors-hub-card-border { padding: 28px 30px; }  /* ─── 28px: PAGE TITLE + STAT NUMBERS ─── */
.page-id-3435 h1 {
 font-size: 28px !important;
 font-weight: 700 !important;
 color: #F0F4FC !important;
 letter-spacing: -0.02em !important;
}
.page-id-3435 h1 span {
 color: #00E59B !important;
}  /* ─── 18px: ALL HEADINGS ─── */
.page-id-3435 h2 {
 font-size: 18px !important;
 font-weight: 700 !important;
 color: #F0F4FC !important;
}
.page-id-3435 .tmb-sectors-hub-card h3,
.page-id-3435 .tmb-sectors-hub-card-border h3,
.page-id-3435 .tmb-feature-card h3,
.page-id-3435 .tmb-sector-theme-title,
.page-id-3435 .tmb-more-card h3 {
 font-size: 18px !important;
 font-weight: 700 !important;
 color: #F0F4FC !important;
}
.page-id-3435 .tmb-faq-question,
.page-id-3435 .tmb-sector-faq-q {
 font-size: 18px !important;
 font-weight: 600 !important;
 color: #F0F4FC !important;
}  /* ─── 16px: ALL BODY TEXT ─── */
.page-id-3435 .entry-content > p {
 font-size: 16px !important;
 line-height: 1.7 !important;
 color: #F0F4FC !important;
}
.page-id-3435 .tmb-sectors-hub-card-border > p:first-of-type,
.page-id-3435 .tmb-sectors-hub-card-content > p:first-of-type {
 color: #F0F4FC !important;
 font-size: 16px !important;
 line-height: 1.6 !important;
}
.page-id-3435 .tmb-sectors-hub-card-border > p:nth-of-type(2),
.page-id-3435 .tmb-sectors-hub-card-content > p:nth-of-type(2),
.page-id-3435 .tmb-sectors-hub-card-border > p[style*="color: #8b949e"] {
 color: #F0F4FC !important;
 font-size: 16px !important;
 line-height: 1.6 !important;
}
.page-id-3435 .tmb-feature-card p,
.page-id-3435 .tmb-sector-theme-text {
 font-size: 16px !important;
 color: #F0F4FC !important;
 line-height: 1.6 !important;
}
.page-id-3435 .tmb-more-card p {
 color: #F0F4FC !important;
 font-size: 16px !important;
 line-height: 1.6 !important;
}
.page-id-3435 .tmb-faq-answer p,
.page-id-3435 .tmb-sector-faq-a-inner {
 font-size: 16px !important;
 color: #F0F4FC !important;
 line-height: 1.65 !important;
}
.page-id-3435 .entry-content > p[style*="font-style: italic"],
.page-id-3435 .tmb-sector-section-desc {
 font-size: 16px !important;
 color: #F0F4FC !important;
}
.page-id-3435 .tmb-sectors-subtitle,
.page-id-3435 .tmb-sector-hero-desc {
 font-size: 16px !important;
 color: #F0F4FC !important;
}  /* ─── 14px: META / LABELS / TICKERS / CTAs ─── */
.page-id-3435 .tmb-stat-label,
.page-id-3435 .tmb-sector-stats-label {
 font-size: 14px !important;
 color: #F0F4FC !important;
 text-transform: uppercase !important;
 letter-spacing: 0.08em !important;
}
.page-id-3435 .tmb-sectors-hub-card-tickers {
 color: #F0F4FC !important;
 font-size: 14px !important;
}
.page-id-3435 .tmb-ticker-chip {
 color: #F0F4FC !important;
 font-size: 14px !important;
 font-weight: 600 !important;
}
.page-id-3435 .tmb-ticker-sep {
 color: #F0F4FC !important;
 font-size: 14px !important;
}
.page-id-3435 .tmb-sectors-hub-card-count,
.page-id-3435 .tmb-sectors-hub-card-tickers > span[style*="font-weight: 600"] {
 font-size: 14px;
 font-weight: 600;
}
.page-id-3435 .tmb-sectors-hub-card-link,
.page-id-3435 .tmb-sectors-hub-card-border > span:last-child {
 font-size: 14px;
 font-weight: 600;
}
.page-id-3435 .tmb-more-card > span[style*="color"] {
 font-size: 14px !important;
 font-weight: 600 !important;
}
.page-id-3435 .entry-content > p[style*="color: #484f58"] {
 font-size: 14px !important;
 color: #F0F4FC !important;
}
.page-id-3435 .tmb-sectors-label,
.page-id-3435 .tmb-sector-hero-label {
 color: #00E59B !important;
 font-size: 14px !important;
}  /* ── KEEP GREEN ON INTERACTIVE ELEMENTS ── */
.page-id-3435 .entry-content > p > a,
.page-id-3435 .tmb-sector-overview a {
 color: #00E59B !important;
}
/* Ticker chips layout */
.tmb-sectors-hub-card-tickers { display: flex !important; flex-wrap: wrap !important; align-items: center !important; gap: 6px !important; }
.tmb-ticker-chip { display: inline-flex !important; align-items: center !important; gap: 4px !important; font-weight: 600 !important; }
.tmb-ticker-logo { width: 18px; height: 18px; object-fit: contain; border-radius: 4px; vertical-align: middle; }
/* Features grid */
.tmb-features-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 24px; }
.tmb-feature-card { background: #0d1117; border: 1px solid #1b2436; border-radius: 14px; padding: 24px; }
/* More research grid */
.tmb-more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 24px; }
.tmb-more-card { background: #0d1117; border: 1px solid #1b2436; border-radius: 14px; padding: 24px; transition: border-color 0.25s ease, transform 0.25s ease; display: block; }
.tmb-more-card:hover { border-color: #2a3650; transform: translateY(-2px); }
/* FAQ accordion */
.tmb-faq-section { display: grid; gap: 0; }
.tmb-faq-item { border-bottom: 1px solid #1b2436; }
.tmb-faq-item:first-child { border-top: 1px solid #1b2436; }
.tmb-faq-question { font-family: var(--tmb-font-heading) !important; cursor: pointer; display: flex !important; justify-content: space-between !important; align-items: center !important; gap: 16px; background: none !important; border: none !important; width: 100%; text-align: left !important; padding: 20px 0 !important; border-radius: 0 !important; text-transform: none !important; letter-spacing: 0 !important; transition: color 0.2s !important; transform: none !important; }
.tmb-faq-question:hover { color: var(--tmb-accent) !important; background: none !important; transform: none !important; }
.tmb-faq-question span { font-size: 18px; color: #F0F4FC; flex-shrink: 0; transition: transform 0.3s ease, color 0.2s; line-height: 1; }
.tmb-faq-item.open .tmb-faq-question span { transform: rotate(45deg); color: var(--tmb-accent); }
.tmb-faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
.tmb-faq-item.open .tmb-faq-answer { max-height: 600px; }
.tmb-faq-answer p { margin: 0 0 12px !important; padding: 0 !important; }
.tmb-faq-answer p:first-child { border-top: 1px solid #1b2436; padding-top: 16px !important; }
.tmb-faq-answer p:last-child { margin-bottom: 20px !important; }
/* wpautop fix */
.tmb-features-grid > p, .tmb-more-grid > p, .tmb-faq-section > p, .tmb-sectors-stats > p { display: none !important; }
/* Responsive */
@media (max-width: 768px) {
 .tmb-sectors-hero { padding: 32px 16px 28px; }
 .tmb-sectors-stats { gap: 24px; }
 .tmb-stat-number { font-size: 24px !important; }
 .tmb-features-grid { grid-template-columns: 1fr; }
 .tmb-more-grid { grid-template-columns: 1fr; }
 .tmb-sectors-hub-card-border { padding: 20px; }
}  /* ═══════════════════════════════════════
 v18 FIXES — Card gaps, FAQ text, links, spacing
 ═══════════════════════════════════════ */
.tmb-features-grid { gap: 0 !important; margin-bottom: 48px !important; padding-bottom: 0 !important; }
.tmb-feature-card { margin: 0 !important; }
.tmb-more-grid { margin-bottom: 48px !important; }
.tmb-faq-section p, .tmb-sector-faq p, .tmb-sector-section-desc { color: #e6edf3 !important; }
.tmb-sector-overview a, .tmb-sector-content > .tmb-sector-overview a, .tmb-sector-faq-a a, .tmb-sector-faq-a-inner a, .tmb-faq-answer a, .tmb-sector-theme-text a, .tmb-sector-latest-text a, .tmb-feature-card a, .entry-content > p a { color: #00E59B !important; text-decoration: underline !important; text-decoration-color: rgba(0, 229, 155, 0.4) !important; text-underline-offset: 2px !important; }
.tmb-sector-overview a:hover, .tmb-sector-faq-a a:hover, .tmb-sector-faq-a-inner a:hover, .tmb-faq-answer a:hover, .tmb-sector-theme-text a:hover, .tmb-sector-latest-text a:hover, .tmb-feature-card a:hover, .entry-content > p a:hover { color: #ffffff !important; text-decoration-color: rgba(255, 255, 255, 0.7) !important; }
.tmb-sector-card-link, .tmb-sector-crosslink { text-decoration: none !important; }
.tmb-more-card span, .tmb-sectors-hub-card span, .page-id-3435 .tmb-sectors-hub-card span, .page-id-3435 a.tmb-sectors-hub-card span, .page-id-3435 .tmb-sectors-hub-card-border span { color: #F0F4FC !important; }
.page-id-3435 .tmb-sectors-hub-card-desc, .page-id-3435 .tmb-sectors-hub-card-border .tmb-sectors-hub-card-desc { color: #F0F4FC !important; }
/* ═══════════════════════════════════════
 SECTOR RESTRUCTURE v1 — Profile hero gradients + badges
 ═══════════════════════════════════════ */
.tmb-profile-hero.grad-semi     { background: linear-gradient(135deg, #1e3a5f 0%, #0d1117 70%); }
.tmb-profile-hero.grad-robotics { background: linear-gradient(135deg, #064e3b 0%, #0d1117 70%); }
.tmb-profile-hero.grad-cyber    { background: linear-gradient(135deg, #4a1010 0%, #0d1117 70%); }
.tmb-profile-hero.grad-biotech  { background: linear-gradient(135deg, #0d3320 0%, #0d1117 70%); }
.tmb-sector-badge.semi    { background: rgba(91,156,255,0.12);  color: #5B9CFF; }
.tmb-sector-badge.robotics{ background: rgba(0,229,155,0.12);   color: #00E59B; }
.tmb-sector-badge.cyber   { background: rgba(255,92,92,0.12);   color: #FF5C5C; }
.tmb-sector-badge.biotech { background: rgba(16,185,129,0.12);  color: #10B981; }
.tmb-sector-badge.space   { background: rgba(139,92,246,0.12);  color: #8B5CF6; }
