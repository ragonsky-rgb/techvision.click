 --tmb-purple: #A78BFA;
 --tmb-cyan: #22D3EE;
 --tmb-font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
 --tmb-font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
 --tmb-font-mono: 'DM Mono', 'SF Mono', Consolas, monospace;
}
/* ─── GLOBAL RESET ─── */
body {
 background-color: var(--tmb-bg) !important;
 color: var(--tmb-text-primary) !important;
 font-family: var(--tmb-font-body) !important;
 font-size: 16px !important;
 line-height: 1.7 !important;
 -webkit-font-smoothing: antialiased;
 -moz-osx-font-smoothing: grayscale;
}
::selection { background: rgba(0,229,155,0.25); color: var(--tmb-white); }
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--tmb-bg); }
::-webkit-scrollbar-thumb { background: var(--tmb-border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--tmb-border-light); }
/* ─── TYPOGRAPHY ─── */
h1, .entry-title { font-family: var(--tmb-font-heading) !important; color: var(--tmb-white) !important; font-weight: 700 !important; font-size: 36px !important; line-height: 1.2 !important; letter-spacing: -0.02em !important; }
h2 { font-family: var(--tmb-font-heading) !important; color: var(--tmb-white) !important; font-weight: 600 !important; font-size: 24px !important; line-height: 1.3 !important; letter-spacing: -0.01em !important; }
h3 { font-family: var(--tmb-font-heading) !important; color: var(--tmb-white) !important; font-weight: 600 !important; font-size: 20px !important; line-height: 1.35 !important; }
h4, h5, h6 { font-family: var(--tmb-font-heading) !important; color: var(--tmb-white) !important; font-weight: 600 !important; font-size: 16px !important; line-height: 1.4 !important; }
p, li, td, th, dd, dt, blockquote { color: var(--tmb-text-primary) !important; font-size: 16px !important; line-height: 1.75 !important; }
.entry-meta, .entry-meta a, .posted-on, .byline, .cat-links, .tags-links, .comments-link, .post-navigation .meta-nav, figcaption, .wp-caption-text { color: var(--tmb-text-muted) !important; font-size: 12px !important; font-family: var(--tmb-font-body) !important; }
small, .site-info, .copyright { color: var(--tmb-text-muted) !important; font-size: 12px !important; }
/* ─── LINKS ─── */
a { color: var(--tmb-accent) !important; text-decoration: none !important; transition: color 0.15s ease !important; }
a:hover { color: var(--tmb-accent-muted) !important; }
.entry-content a { text-decoration: underline !important; text-decoration-color: rgba(0,229,155,0.3) !important; text-underline-offset: 3px !important; }
.entry-content a:hover { text-decoration-color: var(--tmb-accent) !important; }
/* ─── SITE HEADER ─── */
.site-header { background-color: var(--tmb-bg) !important; border-bottom: 1px solid var(--tmb-border) !important; }
.main-title a, .site-title a { font-family: var(--tmb-font-heading) !important; color: var(--tmb-white) !important; font-weight: 700 !important; font-size: 20px !important; }
.site-description { color: var(--tmb-text-muted) !important; font-size: 12px !important; letter-spacing: 0.08em !important; text-transform: uppercase !important; }
/* ─── NAVIGATION ─── */
.main-navigation, .main-navigation .main-nav { background-color: var(--tmb-bg) !important; }
.main-navigation a { color: var(--tmb-text-secondary) !important; font-family: var(--tmb-font-body) !important; font-weight: 500 !important; font-size: 14px !important; text-decoration: none !important; transition: color 0.15s ease !important; }
.main-navigation a:hover, .main-navigation .current-menu-item > a, .main-navigation .current-menu-ancestor > a { color: var(--tmb-white) !important; }
.main-navigation ul ul { background-color: var(--tmb-bg-elevated) !important; border: 1px solid var(--tmb-border) !important; border-radius: 10px !important; box-shadow: 0 16px 48px rgba(0,0,0,0.6) !important; padding: 6px !important; }
.main-navigation ul ul a { color: var(--tmb-text-secondary) !important; font-size: 12px !important; border-radius: 6px !important; }
.main-navigation ul ul a:hover { background-color: rgba(255,255,255,0.04) !important; color: var(--tmb-white) !important; }
/* ─── NAV ACTIVE STATE ─── */
.main-navigation .main-nav ul li > a, .main-navigation .main-nav ul li > a:visited { background: none !important; background-color: transparent !important; border: none !important; box-shadow: none !important; outline: none !important; color: #8896B0 !important; padding: 8px 16px !important; border-radius: 6px !important; font-size: 14px !important; font-weight: 500 !important; transition: all 0.15s ease !important; }
.main-navigation .main-nav ul li > a:hover { background-color: rgba(255,255,255,0.06) !important; color: #F0F4FC !important; }
.main-navigation .main-nav ul li[class*="current-menu"] > a, .main-navigation .main-nav ul li[class*="current_page"] > a, .main-navigation .main-nav ul li.current-menu-item > a, .main-navigation .main-nav ul li.current-menu-parent > a, .main-navigation .main-nav ul li.current-menu-ancestor > a { background-color: rgba(255,255,255,0.06) !important; color: #F0F4FC !important; font-weight: 600 !important; }
.main-navigation .main-nav ul li[class*="current-menu"] > a:hover, .main-navigation .main-nav ul li.current-menu-item > a:hover { background-color: rgba(255,255,255,0.08) !important; color: #F0F4FC !important; }
/* ─── TAGLINE IN NAV BAR ─── */
.navigation-branding .main-title::after { content: "TRACKING TECH STOCKS SHAPING THE FUTURE"; display: block; font-family: var(--tmb-font-body) !important; color: #556380 !important; font-size: 10px !important; font-weight: 600 !important; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1; margin-top: 3px; }
.navigation-branding .main-title a, .main-navigation .main-title a, .main-navigation .site-branding a { font-family: var(--tmb-font-heading) !important; color: #F0F4FC !important; font-weight: 700 !important; font-size: 20px !important; text-decoration: none !important; text-transform: none !important; }
.main-navigation { position: sticky !important; top: 0 !important; z-index: 999 !important; }
/* ─── SITE CONTENT ─── */
.site-content { background-color: var(--tmb-bg) !important; }
.inside-article { background-color: transparent !important; border: none !important; }
/* ─── SIDEBAR ─── */
.widget-area .widget { background-color: var(--tmb-bg-card) !important; border: 1px solid var(--tmb-border) !important; border-radius: 14px !important; padding: 20px !important; margin-bottom: 20px !important; }
.widget-area .widget-title { font-family: var(--tmb-font-body) !important; color: var(--tmb-text-muted) !important; font-size: 12px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.08em !important; border-bottom: 1px solid var(--tmb-border-subtle) !important; padding-bottom: 12px !important; margin-bottom: 14px !important; }
.widget-area a { color: var(--tmb-text-secondary) !important; }
.widget-area a:hover { color: var(--tmb-white) !important; }
/* ─── FOOTER ─── */
.site-footer { background-color: rgba(0,0,0,0.4) !important; border-top: 1px solid var(--tmb-border) !important; }
.site-footer, .site-footer a, .site-footer p, .site-info { color: var(--tmb-text-muted) !important; }
.site-footer a:hover { color: var(--tmb-text-secondary) !important; }
.footer-widgets-container { background-color: rgba(0,0,0,0.4) !important; }
.footer-widgets .widget { background-color: transparent !important; border: none !important; border-radius: 0 !important; padding: 0 !important; }
.footer-widgets a { color: var(--tmb-text-secondary) !important; text-decoration: none !important; }
.footer-widgets a:hover { color: var(--tmb-white) !important; }
.footer-widgets p, .footer-widgets li { color: var(--tmb-text-muted) !important; font-size: 12px !important; }
.site-footer h2, .site-footer h3, .site-footer h4, .footer-widgets h2, .footer-widgets h3, .footer-widgets h4, .inside-footer-widgets h2, .inside-footer-widgets h3, .inside-footer-widgets h4, .footer-widgets .widget-title, .site-footer .widget-title { font-family: var(--tmb-font-body) !important; font-size: 12px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; color: var(--tmb-text-muted) !important; margin-bottom: 16px !important; }
/* ─── BUTTONS ─── */
button, input[type="submit"], .wp-block-button__link, .button { background-color: var(--tmb-accent) !important; color: var(--tmb-bg) !important; font-family: var(--tmb-font-body) !important; font-weight: 800 !important; font-size: 12px !important; letter-spacing: 0.05em !important; text-transform: uppercase !important; border: none !important; border-radius: 8px !important; padding: 10px 20px !important; cursor: pointer !important; transition: all 0.2s ease !important; }
button:hover, input[type="submit"]:hover, .wp-block-button__link:hover, .button:hover { background-color: var(--tmb-accent-muted) !important; transform: translateY(-1px) !important; }
/* ─── FORMS ─── */
input[type="text"], input[type="email"], input[type="search"], input[type="url"], input[type="password"], input[type="number"], textarea, select { background-color: rgba(0,0,0,0.3) !important; border: 1px solid var(--tmb-border) !important; border-radius: 8px !important; color: var(--tmb-white) !important; font-family: var(--tmb-font-body) !important; font-size: 14px !important; padding: 10px 14px !important; }
input:focus, textarea:focus, select:focus { border-color: var(--tmb-accent) !important; outline: none !important; box-shadow: 0 0 0 3px var(--tmb-accent-dim) !important; }
::placeholder { color: var(--tmb-text-muted) !important; opacity: 1 !important; }
/* ─── TABLES ─── */
table { border-collapse: collapse !important; width: 100% !important; }
th { color: var(--tmb-text-muted) !important; font-size: 12px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.06em !important; padding: 10px 16px !important; border-bottom: 1px solid var(--tmb-border) !important; text-align: left !important; }
td { padding: 14px 16px !important; border-bottom: 1px solid var(--tmb-border-subtle) !important; }
tr:last-child td { border-bottom: none !important; }
/* ─── MISC ELEMENTS ─── */
blockquote { border-left: 3px solid var(--tmb-accent) !important; background-color: var(--tmb-bg-card) !important; padding: 16px 20px !important; border-radius: 0 10px 10px 0 !important; margin: 24px 0 !important; }
code, pre { font-family: var(--tmb-font-mono) !important; background-color: var(--tmb-bg-card) !important; color: var(--tmb-accent) !important; border-radius: 6px !important; }
code { padding: 2px 6px !important; font-size: 14px !important; }
pre { padding: 16px 20px !important; border: 1px solid var(--tmb-border) !important; overflow-x: auto !important; }
.entry-content img { border-radius: 12px !important; border: 1px solid var(--tmb-border) !important; }
hr { border: none !important; border-top: 1px solid var(--tmb-border) !important; margin: 32px 0 !important; }
/* ─── POST CARDS ─── */
article.post { background-color: var(--tmb-bg-card) !important; border: 1px solid var(--tmb-border) !important; border-radius: 14px !important; overflow: hidden !important; transition: border-color 0.25s ease, transform 0.25s ease !important; margin-bottom: 20px !important; }
article.post:hover { border-color: var(--tmb-border-light) !important; transform: translateY(-2px) !important; }
.post-image { border-radius: 0 !important; border: none !important; }
/* ─── PAGINATION ─── */
.pagination a, .page-numbers { color: var(--tmb-text-secondary) !important; background-color: var(--tmb-bg-card) !important; border: 1px solid var(--tmb-border) !important; border-radius: 8px !important; padding: 8px 14px !important; font-size: 12px !important; }
.pagination a:hover, .page-numbers:hover { border-color: var(--tmb-border-light) !important; color: var(--tmb-white) !important; }
.page-numbers.current { background-color: var(--tmb-accent) !important; color: var(--tmb-bg) !important; border-color: var(--tmb-accent) !important; }  /* ═══════════════════════════════════════
 MOBILE MENU — OVERLAY FIX v7
 ═══════════════════════════════════════ */
.menu-toggle, .menu-toggle:hover, .menu-toggle:focus, button.menu-toggle, .main-navigation .menu-toggle { background-color: transparent !important; color: var(--tmb-text-secondary) !important; border: 1px solid var(--tmb-border) !important; border-radius: 8px !important; padding: 8px 14px !important; font-size: 12px !important; font-weight: 600 !important; letter-spacing: 0.05em !important; text-transform: uppercase !important; transform: none !important; }
.menu-toggle:hover { border-color: var(--tmb-border-light) !important; color: var(--tmb-white) !important; }
.main-navigation button, .main-navigation button:hover, .main-navigation button:focus, nav button, nav button:hover, nav button:focus, #site-navigation button, #site-navigation button:hover { background-color: transparent !important; color: var(--tmb-text-secondary) !important; border: 1px solid var(--tmb-border) !important; border-radius: 8px !important; padding: 8px 14px !important; transform: none !important; text-transform: none !important; font-weight: 500 !important; letter-spacing: 0 !important; }
#generate-slideout-menu, #generate-slideout-menu.slideout-navigation, .slideout-navigation, .main-navigation .slideout-navigation { position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100% !important; height: 100vh !important; height: 100dvh !important; z-index: 10000 !important; background: #06090F !important; background-color: #06090F !important; background-image: none !important; overflow-y: auto !important; }
#generate-slideout-menu .inside-navigation, #generate-slideout-menu > *, .slideout-navigation .inside-navigation, .slideout-navigation > * { background: #06090F !important; background-color: #06090F !important; background-image: none !important; }
#generate-slideout-menu .main-nav ul, #generate-slideout-menu .main-nav > ul, #generate-slideout-menu .inside-navigation ul, .slideout-navigation .main-nav ul, .slideout-navigation .inside-navigation ul { justify-content: flex-start !important; align-content: flex-start !important; align-items: flex-start !important; gap: 0 !important; row-gap: 0 !important; }
#generate-slideout-menu .main-nav li, #generate-slideout-menu .main-nav ul li, #generate-slideout-menu .inside-navigation li, .slideout-navigation .main-nav li, .slideout-navigation li { flex: 0 0 auto !important; flex-grow: 0 !important; flex-shrink: 0 !important; flex-basis: auto !important; height: auto !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; }
#generate-slideout-menu button, #generate-slideout-menu button:hover, #generate-slideout-menu button:focus, .slideout-navigation button, .slideout-navigation button:hover, button.menu-bar-close, .main-navigation .menu-bar-close { background-color: var(--tmb-bg-card) !important; color: var(--tmb-text-secondary) !important; border: 1px solid var(--tmb-border) !important; border-radius: 6px !important; padding: 6px 12px !important; font-size: 14px !important; font-weight: 500 !important; transform: none !important; text-transform: none !important; letter-spacing: 0 !important; }
#generate-slideout-menu .main-nav li a, #generate-slideout-menu li a, .slideout-navigation .main-nav li a, .slideout-navigation li a { padding: 14px 20px !important; font-size: 16px !important; color: #C8D3E6 !important; border-bottom: 1px solid rgba(255,255,255,0.06) !important; display: block !important; background: none !important; background-color: transparent !important; line-height: 1.4 !important; text-align: left !important; height: auto !important; min-height: 0 !important; }
#generate-slideout-menu .main-nav li a:hover, .slideout-navigation .main-nav li a:hover { color: #F0F4FC !important; background-color: rgba(255,255,255,0.04) !important; }
#generate-slideout-menu .menu-item-has-children > .dropdown-menu-toggle, .slideout-navigation .menu-item-has-children > .dropdown-menu-toggle { background-color: transparent !important; border: none !important; color: var(--tmb-text-muted) !important; padding: 10px !important; }
.slideout-overlay, div.slideout-overlay { background-color: rgba(0,0,0,0.85) !important; }  /* ═══════════════════════════════════════
 DESIGN TOKENS & UTILITY CLASSES
 ═══════════════════════════════════════ */
.sector-badge { display: inline-block !important; font-family: var(--tmb-font-body) !important; font-size: 12px !important; font-weight: 700 !important; letter-spacing: 0.06em !important; text-transform: uppercase !important; padding: 4px 10px !important; border-radius: 6px !important; line-height: 1.2 !important; white-space: nowrap !important; }
.sector-ai { background-color: rgba(91,156,255,0.12) !important; color: #5B9CFF !important; }
.sector-infra { background-color: rgba(0,229,155,0.12) !important; color: #00E59B !important; }
.sector-defence { background-color: rgba(255,181,71,0.12) !important; color: #FFB547 !important; }
.sector-space { background-color: rgba(167,139,250,0.12) !important; color: #A78BFA !important; }
.sector-pharma { background-color: rgba(255,92,92,0.12) !important; color: #FF5C5C !important; }
.tmb-card { background-color: #0d1117 !important; border: 1px solid #1b2436 !important; border-radius: 14px !important; padding: 24px !important; transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease !important; }
.tmb-card:hover { border-color: #2a3650 !important; transform: translateY(-2px) !important; box-shadow: 0 8px 32px rgba(0,0,0,0.3) !important; }
.tmb-card-flat { background-color: #0d1117 !important; border: 1px solid #1b2436 !important; border-radius: 14px !important; padding: 24px !important; }
.tmb-card-elevated { background-color: #141c28 !important; border: 1px solid #1b2436 !important; border-radius: 14px !important; padding: 24px !important; transition: border-color 0.25s ease, transform 0.25s ease !important; }
.tmb-card-elevated:hover { border-color: #2a3650 !important; transform: translateY(-2px) !important; }
.tmb-mono { font-family: var(--tmb-font-mono) !important; font-variant-numeric: tabular-nums !important; }
.tmb-price-up { color: #00E59B !important; font-family: var(--tmb-font-mono) !important; }
.tmb-price-down { color: #FF5C5C !important; font-family: var(--tmb-font-mono) !important; }
.tmb-price-flat { color: #8896B0 !important; font-family: var(--tmb-font-mono) !important; }
.tmb-muted { color: #556380 !important; font-size: 12px !important; }
.tmb-secondary { color: #8896B0 !important; }
.tmb-white { color: #F0F4FC !important; }
.tmb-accent { color: #00E59B !important; }
.tmb-tag { display: inline-block !important; font-family: var(--tmb-font-body) !important; font-size: 12px !important; font-weight: 700 !important; letter-spacing: 0.08em !important; text-transform: uppercase !important; padding: 3px 8px !important; border-radius: 4px !important; background-color: rgba(255,255,255,0.06) !important; color: #8896B0 !important; }
.tmb-ticker { font-family: var(--tmb-font-mono) !important; font-size: 12px !important; font-weight: 500 !important; color: #8896B0 !important; background-color: rgba(255,255,255,0.04) !important; padding: 2px 6px !important; border-radius: 4px !important; }
.tmb-section-label { font-family: var(--tmb-font-body) !important; font-size: 12px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; color: #556380 !important; margin-bottom: 12px !important; }
.tmb-divider { border: none !important; border-top: 1px solid #1b2436 !important; margin: 24px 0 !important; }
.tmb-home h1, .tmb-home h2, .tmb-home h3 { text-transform: none !important; }
.tmb-home a, .tmb-home a:hover, .tmb-home a:visited { text-decoration: none !important; }
@media (max-width: 768px) {
 .tmb-home section:first-child { padding-top: 16px !important; }
 .tmb-hero-image { height: 160px !important; }
 .tmb-hero-title { font-size: 20px !important; }
 .tmb-hero-content { padding: 12px 16px 16px !important; }
 .tmb-hero-excerpt { font-size: 14px !important; margin-bottom: 10px !important; }
 .tmb-hero-card-body { padding: 10px 14px !important; }
 .tmb-hero-secondary .tmb-hero-card:last-child { display: none; }
}  /* ═══════════════════════════════════════
 COMPANY PROFILE MOBILE FIX
 ═══════════════════════════════════════ */
.tmb-profile { overflow-x: hidden !important; max-width: 100vw !important; }
.tmb-profile * { max-width: 100%; }
@media (max-width: 768px) {
 .tmb-profile-hero { padding: 20px 16px 0 !important; overflow: hidden !important; }
 .tmb-profile-hero-inner { max-width: 100% !important; overflow: hidden !important; }
 .tmb-profile-hero-grid { flex-direction: column !important; gap: 16px !important; }
 .tmb-profile-hero h1 { font-size: 24px !important; word-wrap: break-word !important; }
 .tmb-profile-hero h1 .ticker { font-size: 16px !important; display: block !important; margin-top: 4px !important; }
 .tmb-profile-hero-desc { font-size: 14px !important; }
 .tmb-price-card { min-width: unset !important; width: 100% !important; text-align: left !important; padding: 16px !important; }
 .tmb-price-card-price { font-size: 24px !important; }
 .tmb-price-card-stats { grid-template-columns: 1fr 1fr !important; }
 .tmb-section-nav-wrapper { margin: 0 -16px !important; padding: 0 16px !important; overflow-x: auto !important; -webkit-overflow-scrolling: touch !important; }
 .tmb-section-nav { min-width: max-content !important; }
 .tmb-section-nav a { padding: 10px 12px !important; font-size: 14px !important; }
 .tmb-profile-body { padding: 20px 16px 32px !important; overflow: hidden !important; }
 .tmb-profile-grid { grid-template-columns: 1fr !important; gap: 24px !important; }
 .tmb-profile-sidebar { position: static !important; margin-top: 24px !important; }
 .tmb-keypoints-grid, .tmb-bullbear-grid { grid-template-columns: 1fr !important; }
 .tmb-profile-main table { display: block !important; overflow-x: auto !important; -webkit-overflow-scrolling: touch !important; }
 .tmb-profile-main h2 { font-size: 20px !important; }
 .tmb-profile-main h3 { font-size: 16px !important; }
 .tmb-about-author { padding: 16px !important; }
 .tmb-about-author-header { flex-direction: column !important; align-items: center !important; text-align: center !important; }
 .tmb-about-author-avatar { width: 70px !important; height: 70px !important; }
 .tmb-about-author-links { justify-content: center !important; flex-wrap: wrap !important; }
 .tmb-featured-image img { max-width: 100% !important; height: auto !important; }
}
@media (max-width: 400px) {
 .tmb-profile-hero h1 { font-size: 20px !important; }
 .tmb-price-card-price { font-size: 20px !important; }
 .tmb-price-card-stats { grid-template-columns: 1fr !important; gap: 8px !important; }
 .tmb-section-nav a { padding: 10px 10px !important; font-size: 12px !important; }
}  /* ═══════════════════════════════════════
 ABOUT THE AUTHOR BLOCK
 ═══════════════════════════════════════ */
.tmb-author-block { max-width: 1300px; margin: 0 auto; padding: 0 32px 48px; box-sizing: border-box; }
@media (max-width: 900px) {
 .tmb-author-block { padding: 0 12px 32px; }
 .tmb-author-block > div[style*="flex"] { flex-direction: column !important; align-items: center !important; text-align: center; }
 .tmb-author-block ul { text-align: left; }
}  /* ═══════════════════════════════════════
 SEARCH RESULTS PAGE
 ═══════════════════════════════════════ */
body.search *, body.search-results * { opacity: 1 !important; }
body.search .site-content, body.search-results .site-content, body.search .content-area, body.search-results .content-area, body.search #primary, body.search-results #primary { background: #06090F !important; }
