.paging-navigation, .site-main > .navigation, .posts-navigation { margin: 40px 0 !important; }
.paging-navigation a, .posts-navigation a, .site-main > .navigation a { background: #0d1117 !important; border: 1px solid #1b2436 !important; color: #8896B0 !important; border-radius: 8px !important; padding: 12px 20px !important; text-decoration: none !important; transition: all 0.2s !important; }
.paging-navigation a:hover, .posts-navigation a:hover, .site-main > .navigation a:hover { border-color: #00E59B !important; color: #00E59B !important; }
body.search article, body.search-results article { background: #0d1117 !important; color: #C8D3E6 !important; }
body.search article *, body.search-results article *, body.search .inside-article *, body.search-results .inside-article * { color: #C8D3E6 !important; background-color: transparent !important; }
body.search .inside-article, body.search-results .inside-article { background: #0d1117 !important; padding: 0 !important; }
body.search article h2, body.search-results article h2, body.search article .entry-title, body.search-results article .entry-title { color: #F0F4FC !important; }
body.search article .read-more, body.search-results article .read-more { background: #00E59B !important; color: #0d1117 !important; }
body.search .page-header, body.search-results .page-header { padding: 40px 0 30px !important; margin-bottom: 30px !important; border-bottom: 1px solid #1b2436 !important; background: transparent !important; }
body.search .page-title, body.search-results .page-title { color: #F0F4FC !important; font-size: 32px !important; font-weight: 600 !important; font-family: 'Space Grotesk', sans-serif !important; text-transform: none !important; }
body.search .page-title span, body.search-results .page-title span { color: #00E59B !important; }
body.search .site-main, body.search-results .site-main { max-width: 900px !important; }
body.search article, body.search-results article, body.search .hentry, body.search-results .hentry { background: #0d1117 !important; border: 1px solid #1b2436 !important; border-radius: 14px !important; padding: 28px !important; margin-bottom: 24px !important; transition: all 0.2s ease !important; }
body.search article:hover, body.search-results article:hover { border-color: #2a3650 !important; transform: translateY(-2px) !important; box-shadow: 0 8px 24px rgba(0,0,0,0.3) !important; }
body.search .entry-title, body.search-results .entry-title { margin: 0 0 16px !important; font-size: 24px !important; line-height: 1.3 !important; }
body.search .entry-title a, body.search-results .entry-title a { color: #F0F4FC !important; text-decoration: none !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 600 !important; transition: color 0.2s !important; }
body.search .entry-title a:hover, body.search-results .entry-title a:hover { color: #00E59B !important; }
body.search .entry-title::after, body.search-results .entry-title::after { border: none !important; content: none !important; }
body.search .entry-meta, body.search-results .entry-meta { color: #556380 !important; font-size: 13px !important; margin-bottom: 14px !important; }
body.search .entry-meta a, body.search-results .entry-meta a { color: #00E59B !important; }
body.search .cat-links a, body.search-results .cat-links a { background: rgba(0,229,155,0.1) !important; color: #00E59B !important; padding: 4px 10px !important; border-radius: 4px !important; font-size: 11px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; text-decoration: none !important; }
body.search .entry-summary, body.search-results .entry-summary { color: #C8D3E6 !important; font-size: 16px !important; line-height: 1.7 !important; }
body.search .entry-summary p, body.search-results .entry-summary p { color: #C8D3E6 !important; margin-bottom: 16px !important; }
body.search .read-more, body.search-results .read-more, body.search .more-link, body.search-results .more-link { display: inline-block !important; background: #00E59B !important; color: #0d1117 !important; padding: 12px 24px !important; border-radius: 8px !important; font-size: 14px !important; font-weight: 600 !important; text-decoration: none !important; transition: all 0.2s !important; margin-top: 12px !important; }
body.search .read-more:hover, body.search-results .read-more:hover { background: #00cc8a !important; transform: translateY(-2px) !important; }
body.search .post-image, body.search-results .post-image { border-radius: 10px !important; overflow: hidden !important; margin-bottom: 16px !important; }
body.search .no-results, body.search-results .no-results { background: #0d1117 !important; border: 1px solid #1b2436 !important; border-radius: 14px !important; padding: 48px !important; text-align: center !important; }
body.search .no-results h2, body.search-results .no-results h2 { color: #F0F4FC !important; font-size: 24px !important; margin-bottom: 16px !important; }
body.search .no-results p, body.search-results .no-results p { color: #8896B0 !important; }
body.search .pagination, body.search-results .pagination { margin-top: 40px !important; display: flex !important; gap: 8px !important; justify-content: center !important; }
body.search .page-numbers, body.search-results .page-numbers { background: #0d1117 !important; border: 1px solid #1b2436 !important; color: #8896B0 !important; padding: 10px 16px !important; border-radius: 8px !important; text-decoration: none !important; }
body.search .page-numbers:hover, body.search-results .page-numbers:hover { border-color: #00E59B !important; color: #00E59B !important; }
body.search .page-numbers.current, body.search-results .page-numbers.current { background: #00E59B !important; border-color: #00E59B !important; color: #0d1117 !important; }  /* ═══════════════════════════════════════
