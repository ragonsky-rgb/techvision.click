 .page-id-3397 .tmb-ec .tmb-ec-grid {
 grid-template-columns: 1fr !important;
 }
}
/* Old tmb-earnings styles (kept for backward compatibility) */
.tmb-earnings * { box-sizing: border-box; }
.tmb-earnings { font-family: 'DM Sans', sans-serif; max-width: 1300px; margin: 0 auto; padding: 0 32px; }
.tmb-earnings a { text-decoration: none; color: inherit; }
.tmb-earn-hero { text-align: center; padding: 48px 0 40px; border-bottom: 1px solid #1b2436; margin-bottom: 40px; }
.tmb-earn-hero h1 { color: #F0F4FC !important; font-size: 42px !important; font-weight: 600 !important; margin: 0 0 16px !important; font-family: 'Space Grotesk', sans-serif !important; text-transform: none !important; }
.tmb-earn-hero p { color: #8896B0; font-size: 18px; line-height: 1.6; max-width: 700px; margin: 0 auto; }
.tmb-earn-hero-stats { display: inline-flex !important; justify-content: center !important; align-items: center !important; gap: 48px; margin-top: 32px; }
.tmb-earn-hero-stat { text-align: center; }
.tmb-earn-hero-stat-value { font-size: 36px; font-weight: 700; font-family: 'Space Grotesk', sans-serif; color: #00E59B; }
.tmb-earn-hero-stat-label { font-size: 14px; color: #556380; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px; }
.tmb-earn-section { margin-bottom: 48px; }
.tmb-earn-section-header { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
.tmb-earn-section-header h2 { color: #F0F4FC !important; font-size: 28px !important; font-weight: 600 !important; margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; text-transform: none !important; }
.tmb-earn-section-header .accent-bar { width: 4px; height: 28px; border-radius: 2px; flex-shrink: 0; background: #00E59B; }
.tmb-earn-section-sub { color: #8896B0; font-size: 15px; margin-top: -16px; margin-bottom: 24px; }
.tmb-earn-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #1b2436; border-radius: 14px; background: #0d1117; }
.tmb-earn-table { width: 100%; border-collapse: collapse; min-width: 800px; }
.tmb-earn-table thead { background: rgba(0,0,0,0.3); }
.tmb-earn-table th { color: #556380 !important; font-size: 11px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.08em !important; padding: 14px 16px !important; border-bottom: 1px solid #1b2436 !important; text-align: left !important; white-space: nowrap; }
.tmb-earn-table td { padding: 16px !important; border-bottom: 1px solid rgba(27,36,54,0.5) !important; font-size: 15px !important; color: #D6DEF0 !important; vertical-align: middle !important; }
.tmb-earn-table tbody tr { transition: background 0.15s; }
.tmb-earn-table tbody tr:hover { background: rgba(255,255,255,0.02); }
.tmb-earn-table tbody tr:last-child td { border-bottom: none !important; }
.tmb-earn-company { display: flex; align-items: center; gap: 10px; }
.tmb-earn-company-name { font-weight: 600; color: #F0F4FC; font-family: 'Space Grotesk', sans-serif; }
.tmb-earn-company-name a { color: #F0F4FC !important; transition: color 0.2s; }
.tmb-earn-company-name a:hover { color: #00E59B !important; }
.tmb-earn-ticker { font-size: 12px; font-weight: 700; font-family: 'DM Mono', monospace; color: #00E59B; background: rgba(0,229,155,0.1); padding: 3px 8px; border-radius: 4px; }
.tmb-earn-date { font-weight: 600; color: #F0F4FC; white-space: nowrap; }
.tmb-earn-time-badge { display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 3px 8px; border-radius: 4px; }
.tmb-earn-time-badge.bmo { background: rgba(91,156,255,0.12); color: #5B9CFF; }
.tmb-earn-time-badge.amc { background: rgba(167,139,250,0.12); color: #A78BFA; }
.tmb-earn-time-badge.tbd { background: rgba(85,99,128,0.12); color: #556380; }
.tmb-earn-estimate { font-family: 'DM Mono', monospace; font-size: 14px; color: #8896B0; }
.tmb-earn-sector-tag { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 8px; border-radius: 4px; }
.tmb-earn-sector-tag.ai { background: rgba(91,156,255,0.12); color: #5B9CFF; }
.tmb-earn-sector-tag.infra { background: rgba(0,229,155,0.12); color: #00E59B; }
.tmb-earn-profile-link { color: #00E59B !important; font-size: 13px; font-weight: 600; white-space: nowrap; transition: color 0.2s; }
.tmb-earn-profile-link:hover { color: #00cc8a !important; }
.tmb-earn-scorecard-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
.tmb-earn-scorecard { background: #0d1117; border: 1px solid #1b2436; border-radius: 14px; padding: 20px; transition: all 0.2s; display: flex; flex-direction: column; }
.tmb-earn-scorecard:hover { border-color: #2a3650; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
.tmb-earn-scorecard-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.tmb-earn-scorecard-company { display: flex; align-items: center; gap: 8px; }
.tmb-earn-scorecard-name { font-size: 18px; font-weight: 600; color: #F0F4FC; font-family: 'Space Grotesk', sans-serif; }
.tmb-earn-scorecard-name a { color: #F0F4FC !important; transition: color 0.2s; }
.tmb-earn-scorecard-name a:hover { color: #00E59B !important; }
.tmb-earn-scorecard-ticker { font-size: 11px; font-weight: 700; font-family: 'DM Mono', monospace; color: #00E59B; background: rgba(0,229,155,0.1); padding: 2px 6px; border-radius: 4px; }
.tmb-earn-badge { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 4px 10px; border-radius: 6px; }
.tmb-earn-badge.beat { background: rgba(0,229,155,0.12); color: #00E59B; }
.tmb-earn-badge.miss { background: rgba(255,92,92,0.12); color: #FF5C5C; }
.tmb-earn-badge.inline, .tmb-earn-badge.mixed { background: rgba(255,181,71,0.12); color: #FFB547; }
.tmb-earn-scorecard-quarter { font-size: 12px; color: #556380; margin-bottom: 14px; }
.tmb-earn-scorecard-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; flex-grow: 1; }
.tmb-earn-metric { background: rgba(0,0,0,0.2); border-radius: 8px; padding: 10px 12px; }
.tmb-earn-metric-label { font-size: 11px; color: #556380; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }
.tmb-earn-metric-value { font-family: 'DM Mono', monospace; font-size: 16px; font-weight: 600; color: #F0F4FC; }
.tmb-earn-metric-sub { font-size: 11px; margin-top: 2px; }
.tmb-earn-metric-sub.up { color: #00E59B; }
.tmb-earn-metric-sub.down { color: #FF5C5C; }
.tmb-earn-metric-sub.neutral { color: #8896B0; }
.tmb-earn-scorecard-reaction { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 14px; border-top: 1px solid #1b2436; }
.tmb-earn-reaction-label { font-size: 12px; color: #556380; }
.tmb-earn-reaction-value { font-family: 'DM Mono', monospace; font-size: 16px; font-weight: 700; }
.tmb-earn-reaction-value.up { color: #00E59B; }
.tmb-earn-reaction-value.down { color: #FF5C5C; }
.tmb-earn-articles-placeholder { background: rgba(0,0,0,0.2); border: 1px dashed #1b2436; border-radius: 14px; padding: 48px; text-align: center; }
.tmb-earn-articles-placeholder h3 { color: #F0F4FC !important; font-size: 20px !important; font-weight: 600 !important; margin: 0 0 12px !important; font-family: 'Space Grotesk', sans-serif !important; }
.tmb-earn-articles-placeholder p { color: #556380; font-size: 15px; margin: 0; }
.tmb-earn-explainer { background: linear-gradient(135deg, rgba(0,229,155,0.03) 0%, transparent 100%); border: 1px solid #1b2436; border-radius: 16px; padding: 40px; margin: 48px 0; }
.tmb-earn-explainer h2 { color: #F0F4FC !important; font-size: 24px !important; font-weight: 600 !important; margin: 0 0 24px !important; font-family: 'Space Grotesk', sans-serif !important; text-transform: none !important; text-align: center; }
.tmb-earn-explainer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.tmb-earn-explainer-item { background: rgba(0,0,0,0.2); border-radius: 10px; padding: 16px; }
.tmb-earn-explainer-item h4 { color: #F0F4FC !important; font-size: 16px !important; font-weight: 600 !important; margin: 0 0 8px !important; font-family: 'Space Grotesk', sans-serif !important; }
.tmb-earn-explainer-item p { color: #8896B0 !important; font-size: 14px !important; line-height: 1.6 !important; margin: 0 !important; }
@media (max-width: 900px) { .tmb-earn-explainer-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) {
 .tmb-earnings { padding: 0 16px; }
 .tmb-earn-hero { padding: 32px 0 28px; }
 .tmb-earn-hero h1 { font-size: 28px !important; }
 .tmb-earn-hero p { font-size: 16px; }
 .tmb-earn-hero-stats { gap: 24px; }
 .tmb-earn-hero-stat-value { font-size: 28px; }
 .tmb-earn-scorecard-grid { grid-template-columns: 1fr; }
 .tmb-earn-explainer-grid { grid-template-columns: 1fr; }
 .tmb-earn-explainer { padding: 24px; }
}
.tmb-earn-scorecard-grid > p, .tmb-earn-explainer-grid > p { display: none !important; }  /* ═══════════════════════════════════════
