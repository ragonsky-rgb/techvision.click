    <div class="bookmarks-title">📑 Bài đã lưu</div>
    <div id="bookmarksList"></div>
  </div>

  <script is:inline src="/articles/_article.js"></script>
  <script is:inline>
    document.querySelectorAll('.faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
      });
    });
    (function(){
      const body = document.querySelector('.art-body');
      if(!body) return;
      const words = body.innerText.trim().split(/\s+/).length;
      const mins = Math.max(1, Math.round(words / 200));
      const el = document.getElementById('readingTime');
      if(el) el.textContent = mins + ' phút đọc';
    })();
    // Ảnh YouTube: lùi về hqdefault khi maxresdefault lỗi 404 hoặc trả ảnh xám placeholder (~120px)
    (function(){
      document.querySelectorAll('img[src*="maxresdefault"]').forEach(function(img){
        function fb(){ if(img.src.indexOf('maxresdefault')>-1){ img.src = img.src.replace('maxresdefault','hqdefault'); } }
        function check(){ if(img.naturalWidth > 0 && img.naturalWidth <= 120){ fb(); } }
        if(img.complete){ if(img.naturalWidth === 0){ fb(); } else { check(); } }
        img.addEventListener('error', fb, { once: true });
        img.addEventListener('load', check, { once: true });
      });
    })();
  </script>

  <div class="tts-player" id="ttsPlayer" role="region" aria-label="Trình đọc bài viết">
    <div class="tts-inner">
      <div class="tts-row1">
        <span class="tts-badge">🎧 AI Đọc Bài</span>
        <span class="tts-preview" id="ttsPreview">{title}…</span>
      </div>
      <div class="tts-bar" id="ttsBar"><div class="tts-bar-track"><div class="tts-fill" id="ttsFill"></div></div></div>
      <div class="tts-row2">
        <button class="tts-play" id="ttsPlayBtn" onclick="TTS.toggle()" aria-label="Phát / Tạm dừng">
          <svg id="ttsIcon" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </button>
        <span class="tts-counter" id="ttsCounter">0 / 0</span>
        <div class="tts-speeds">
          <button class="tts-spd active" data-rate="1"   onclick="TTS.setRate(1)">1×</button>
          <button class="tts-spd"        data-rate="1.5" onclick="TTS.setRate(1.5)">1.5×</button>
          <button class="tts-spd"        data-rate="2"   onclick="TTS.setRate(2)">2×</button>
        </div>
        <button class="tts-close" onclick="TTS.close()" aria-label="Đóng">✕</button>
      </div>
    </div>
  </div>

  <script is:inline>
  const TTS = (() => {
    if (!('speechSynthesis' in window)) {
      document.getElementById('ttsTrigger')?.classList.add('tts-unsupported');
      return { start(){}, toggle(){}, setRate(){}, close(){} };
    }
    let segs = [], idx = 0, playing = false, rateVal = 1, voice = null, gen = 0;
    let rateTimer = null, lastActivity = 0, wasPlaying = false;
    const isIOS    = /iPad|iPhone|iPod/.test(navigator.userAgent);
    const isMobile = isIOS || /Android|Mobi/i.test(navigator.userAgent);
    const Q        = isIOS ? 1 : 4;
    const STALL_MS = isMobile ? 4000 : 2500;
    function loadVoice() {
      const voices = speechSynthesis.getVoices();
      voice = voices.find(v => v.lang === 'vi-VN' && v.localService)
            || voices.find(v => v.lang === 'vi-VN')
            || voices.find(v => v.lang.startsWith('vi'))
            || null;
    }
    loadVoice();
    speechSynthesis.onvoiceschanged = loadVoice;
    function extract() {
      const out = [];
      const push = t => {
        t = t?.trim();
        if (!t || t.length < 5) return;
        if (t.length > 220) {
          const sentences = t.match(/[^.!?]+[.!?…]+\s*/g) || [t];
          sentences.forEach(s => { if (s.trim().length > 5) out.push(s.trim()); });
        } else { out.push(t); }
      };
      push(document.querySelector('.art-title')?.textContent);
      push(document.querySelector('.art-deck')?.textContent);
      const tldr = document.querySelector('.art-tldr p');
      if (tldr) push('Tóm tắt nhanh. ' + tldr.textContent);
      document.querySelectorAll('.art-body p, .art-body h2, .art-body h3, .art-body li').forEach(el => {
        if (el.closest('figure, .art-video-wrap, .spec-box, .source-card')) return;
        push(el.textContent);
      });
      return out;
    }
    const $ = id => document.getElementById(id);
    function ui(overrideIdx) {
      const i = overrideIdx ?? idx;
      const pct = segs.length ? (i / segs.length * 100) : 0;
      $('ttsFill').style.width = pct + '%';
      $('ttsCounter').textContent = i + ' / ' + segs.length;
      if (segs[i]) $('ttsPreview').textContent = segs[i].substring(0, 70) + '…';
      $('ttsIcon').innerHTML = playing
        ? '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>'
        : '<polygon points="5 3 19 12 5 21 5 3"/>';
      $('ttsPlayBtn').classList.toggle('is-paused', !playing);
    }
    function makeUtt(i, g) {
      if (i >= segs.length) return null;
      const utt = new SpeechSynthesisUtterance(segs[i]);
      if (voice) utt.voice = voice;
      utt.lang = 'vi-VN'; utt.rate = rateVal;
      utt.onstart = () => { if (gen === g) { idx = i; lastActivity = Date.now(); ui(); } };
      utt.onend = () => {
        if (gen !== g || !playing) return;
        lastActivity = Date.now(); idx = i + 1; ui();
        if (i + Q < segs.length) speechSynthesis.speak(makeUtt(i + Q, g));
        if (idx >= segs.length) done();
      };
      utt.onerror = e => { if (e.error !== 'interrupted' && e.error !== 'canceled') console.warn('TTS err:', e.error); };
      return utt;
    }
    function speakFrom(startIdx) {
      gen++; const g = gen;
      speechSynthesis.cancel();
      idx = startIdx; playing = true; lastActivity = Date.now(); ui();
      if (idx >= segs.length) { done(); return; }
      const end = Math.min(idx + Q, segs.length);
      for (let i = idx; i < end; i++) speechSynthesis.speak(makeUtt(i, g));
    }
    setInterval(() => {
      if (!playing || speechSynthesis.paused || idx >= segs.length) return;
      if (speechSynthesis.speaking) { lastActivity = Date.now(); return; }
      if (Date.now() - lastActivity > STALL_MS) speakFrom(idx);
    }, 1000);
    document.addEventListener('visibilitychange', () => {
      if (!segs.length) return;
      if (document.hidden) {
        wasPlaying = playing;
        if (playing) { speechSynthesis.pause(); playing = false; ui(); }
      } else if (wasPlaying) {
        wasPlaying = false;
        if (speechSynthesis.paused) { speechSynthesis.resume(); playing = true; ui(); }
        else { speakFrom(idx); }
      }
    });
    function done() {
      playing = false;
      $('ttsFill').style.width = '100%';
      $('ttsCounter').textContent = 'Xong ✓';
      $('ttsIcon').innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
    }
    function barPct(clientX) {
      const rect = $('ttsBar').getBoundingClientRect();
      return Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
    }
    function previewAt(pct) {
      const i = Math.min(segs.length - 1, Math.max(0, Math.round(pct * segs.length)));
      $('ttsFill').style.width = (segs.length ? i / segs.length * 100 : 0) + '%';
      $('ttsCounter').textContent = i + ' / ' + segs.length;
      if (segs[i]) $('ttsPreview').textContent = segs[i].substring(0, 70) + '…';
      return i;
    }
    let seekInited = false;
    function initSeekBar() {
      if (seekInited) return; seekInited = true;
      const bar = $('ttsBar'), fill = $('ttsFill');
      let dragging = false, pendingIdx = null;
      bar.addEventListener('mousedown', e => {
        if (!segs.length) return;
        dragging = true; bar.classList.add('dragging'); fill.style.transition = 'none';
        pendingIdx = previewAt(barPct(e.clientX));
      });
      document.addEventListener('mousemove', e => { if (!dragging) return; pendingIdx = previewAt(barPct(e.clientX)); });
      document.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false; bar.classList.remove('dragging'); fill.style.transition = '';
        if (pendingIdx !== null) { speakFrom(pendingIdx); pendingIdx = null; }
      });
      bar.addEventListener('touchstart', e => {
        if (!segs.length) return;
        dragging = true; bar.classList.add('dragging'); fill.style.transition = 'none';
        pendingIdx = previewAt(barPct(e.touches[0].clientX)); e.preventDefault();
      }, { passive: false });
      document.addEventListener('touchmove', e => {
        if (!dragging) return; pendingIdx = previewAt(barPct(e.touches[0].clientX)); e.preventDefault();
      }, { passive: false });
      document.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false; bar.classList.remove('dragging'); fill.style.transition = '';
        if (pendingIdx !== null) { speakFrom(pendingIdx); pendingIdx = null; }
      });
    }
    return {
      start() { segs = extract(); $('ttsPlayer').classList.add('tts-visible'); $('ttsTrigger').style.display = 'none'; initSeekBar(); speakFrom(0); },
      toggle() {
        if (playing) { speechSynthesis.pause(); playing = false; ui(); }
        else { if (speechSynthesis.paused) { speechSynthesis.resume(); playing = true; ui(); } else { speakFrom(idx); } }
      },
      setRate(r) {
        rateVal = r;
        document.querySelectorAll('.tts-spd').forEach(b => b.classList.toggle('active', parseFloat(b.dataset.rate) === r));
        clearTimeout(rateTimer); rateTimer = setTimeout(() => { if (playing) speakFrom(idx); }, 120);
      },
      close() {
        gen++; speechSynthesis.cancel(); playing = false; idx = 0;
        $('ttsPlayer').classList.remove('tts-visible'); $('ttsTrigger').style.display = '';
        $('ttsFill').style.width = '0%';
      }
    };
  })();
  </script>
</body>
