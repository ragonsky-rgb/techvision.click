---
const { data, slug } = Astro.props;
const {
  title, description, keywords, category,
  datePublished, dateModified,
  deck, heroImage, heroAlt, heroCaption, tldr, tags,
  stats, videos, faq, sourceUrl, sourceName, sourceDomains,
  related, about, authorBio,
} = data;

const SITE = 'https://techvision.click';
const url = `${SITE}/articles/${slug}.html`;
const modified = dateModified || datePublished;
const displayDate = (() => {
  const d = datePublished.slice(0, 10).split('-'); // YYYY-MM-DD
  return d.length === 3 ? `${d[2]}/${d[1]}/${d[0]}` : datePublished;
})();
const bio = authorBio || 'Founder LongTechVision. Theo dõi tin tức công nghệ quốc tế, chọn lọc và dịch sang tiếng Việt cho độc giả trong nước.';

// Ảnh hero dạng ImageObject (thêm kích thước khi là thumbnail YouTube maxresdefault)
const isYtMaxres = heroImage.includes('ytimg.com') && heroImage.includes('maxresdefault');
const heroImageObject = isYtMaxres
  ? { '@type': 'ImageObject', url: heroImage, width: 1280, height: 720 }
  : { '@type': 'ImageObject', url: heroImage };

const newsLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline: title,
  description,
  image: heroImageObject,
  datePublished,
  dateModified: modified,
  author: {
    '@type': 'Person', '@id': `${SITE}/#person`, name: 'Nguyễn Tấn Thiên Long', url: `${SITE}/cv.html`,
    jobTitle: 'Founder & Tech Content Strategist',
    knowsAbout: ['Công nghệ', 'Trí tuệ nhân tạo', 'Smartphone', 'Laptop', 'Camera', 'Thiết bị đeo'],
    sameAs: [
      'https://www.youtube.com/@LongNguyenRV',
      'https://www.tiktok.com/@fastcare.vn',
      'https://www.facebook.com/longnguyen.longnguyenreview/',
      'https://www.linkedin.com/in/nguy%E1%BB%85n-t%E1%BA%A5n-thi%C3%AAn-long-7110751a9/',
    ],
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE}/#organization`,
    name: 'TechVision',
    url: SITE,
    logo: { '@type': 'ImageObject', url: `${SITE}/uploads/favicon-avatar.jpg`, width: 60, height: 60 },
    sameAs: [
      'https://www.youtube.com/@LongNguyenRV',
      'https://www.tiktok.com/@fastcare.vn',
      'https://www.facebook.com/longnguyen.longnguyenreview/',
    ],
  },
  articleSection: category,
  inLanguage: 'vi-VN',
  isAccessibleForFree: true,
  thumbnailUrl: heroImage,
  keywords,
  about: (about && about.length ? about : []).map((n) => ({ '@type': 'Thing', name: n })),
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.art-title', '.art-deck', 'h2', '.art-callout'] },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (faq || []).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Tech News', item: `${SITE}/blog.html` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title.length > 52 ? title : `${title} | TechVision`}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="theme-color" content="#c0392b" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="vi" href={url} />
  <link rel="alternate" hreflang="x-default" href={url} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link rel="preconnect" href="https://i.ytimg.com" />
  <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
  <link rel="icon" type="image/jpeg" href="/uploads/favicon-avatar.jpg" />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/articles/_article-style.css" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <script defer src="/_vercel/insights/script.js"></script>
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content="TechVision" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={heroImage} />
  <meta property="og:image:alt" content={heroAlt} />
  <meta property="article:published_time" content={datePublished} />
  <meta property="article:modified_time" content={modified} />
  <meta property="article:section" content={category} />
  {(tags || []).map((t) => (<meta property="article:tag" content={t} />))}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={heroImage} />
  <meta name="twitter:image:alt" content={heroAlt} />
  <script type="application/ld+json" set:html={JSON.stringify(newsLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <style is:global>
    figure { margin: 2rem 0; text-align: center; }
    figure + figure, figure + .art-video-label, .art-video-wrap + figure, .art-video-caption + figure { margin-top: 3rem; }
    figure img { width: 100%; max-width: 820px; border-radius: 10px; display: block; margin: 0 auto; }
    figcaption { margin-top: .6rem; font-size: .78rem; color: var(--dim); font-style: italic; font-family: var(--sans); }

    .art-video-wrap { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 10px; margin: 2rem 0; background: #000; }
    .art-video-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
    .art-video-label { font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--dim); margin-bottom: .5rem; font-family: var(--sans); }
    .art-video-caption { font-size: .72rem; color: var(--dim); font-style: italic; text-align: center; margin-top: .5rem; font-family: var(--sans); }

    .art-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 2rem 0; }
    @media (max-width: 540px) { .art-stats { grid-template-columns: repeat(2, 1fr); gap: .7rem; } .art-stat-card { padding: .9rem .7rem; } .art-stat-card .stat-num { font-size: 1.2rem; } }
    .art-stat-card { background: var(--surface, #f7f7f7); border: 1px solid var(--line, #e8e8e8); border-radius: 10px; padding: 1rem .9rem; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .art-stat-card .stat-num { font-size: 1.4rem; font-weight: 700; color: var(--accent, #c0392b); font-family: var(--sans); line-height: 1.15; }
    .art-stat-card .stat-label { font-size: .72rem; color: var(--dim); margin-top: .35rem; font-family: var(--sans); line-height: 1.4; }

    .art-callout { background: var(--surface, #f7f7f7); border-left: 3px solid var(--accent, #c0392b); border-radius: 0 10px 10px 0; padding: 1rem 1.2rem; margin: 1.5rem 0; font-family: var(--sans); font-size: .9rem; line-height: 1.6; color: var(--text, #1c1a17); }
    .art-callout a { color: var(--accent, #c0392b); font-weight: 600; text-decoration: underline; }

    .art-tag-row { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 2rem; }
    .art-tag { font-size: .72rem; font-family: var(--sans); padding: .25rem .7rem; border-radius: 20px; border: 1px solid var(--line, #e8e8e8); color: var(--dim); text-decoration: none; transition: border-color .2s, color .2s; }
    .art-tag:hover { border-color: var(--accent); color: var(--accent); }

    .spec-box { background: var(--surface, #f7f7f7); border: 1px solid var(--line, #e8e8e8); border-radius: 10px; padding: 1.2rem 1.4rem; margin: 1.5rem 0; font-family: var(--sans); }
    .spec-box-title { font-size: .65rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--accent, #c0392b); margin-bottom: .8rem; }
    .spec-box table { width: 100%; border-collapse: collapse; }
    .spec-box td { font-size: .85rem; line-height: 1.7; color: var(--text, #1c1a17); padding: .3rem 0; vertical-align: top; }
    .spec-box td:first-child { font-weight: 600; width: 48%; padding-right: 1rem; color: var(--text, #111); }
    .spec-box tr { border-bottom: 1px solid var(--line, #e8e8e8); }
    .spec-box tr:last-child { border-bottom: none; }

    /* Bảng Markdown thuần trong thân bài (không phải spec-box) */
    .art-body table:not(.spec-box table) { width: 100%; border-collapse: collapse; margin: 1.4rem 0; font-family: var(--sans); font-size: .88rem; }
    .art-body table:not(.spec-box table) th { text-align: left; padding: .55rem .6rem; border-bottom: 2px solid var(--accent, #c0392b); font-weight: 700; }
    .art-body table:not(.spec-box table) td { padding: .5rem .6rem; border-bottom: 1px solid var(--line, #e8e8e8); vertical-align: top; line-height: 1.6; }
    .art-body table:not(.spec-box table) tbody tr:nth-child(odd) { background: var(--surface, #f7f7f7); }

    .art-faq { margin: 2.5rem 0; }
    .art-faq-label { font-size: .62rem; letter-spacing: .22em; text-transform: uppercase; color: var(--dim); font-family: var(--sans); margin-bottom: 1rem; }
    .faq-item { border-bottom: 1px solid var(--line, #e8e8e8); }
    .faq-item:first-of-type { border-top: 1px solid var(--line, #e8e8e8); }
    .faq-q { width: 100%; background: none; border: none; padding: 1rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem; cursor: pointer; font-size: .95rem; font-weight: 600; font-family: var(--sans); color: var(--text, #111); text-align: left; }
    .faq-q .faq-icon { flex-shrink: 0; font-size: 1.1rem; color: var(--accent, #c0392b); transition: transform .25s; }
    .faq-item.open .faq-q .faq-icon { transform: rotate(45deg); }
    .faq-a { display: none; padding: 0 0 1rem; font-size: .88rem; line-height: 1.7; color: var(--text, #1c1a17); font-family: var(--sans); }
    .faq-item.open .faq-a { display: block; }

  /* ── TTS Player ── */
  .tts-trigger {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.42rem 1rem;
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 99px;
    font-family: var(--sans); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.06em; cursor: pointer;
    transition: background .2s, color .2s;
    margin-top: 1.1rem; margin-bottom: 0.2rem;
  }
  .tts-trigger:hover { background: var(--accent); color: #fff; }
  .tts-trigger svg { width: 13px; height: 13px; flex-shrink: 0; }
  .tts-trigger.tts-unsupported { display: none; }

  .tts-player {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 990;
    background: rgba(14,12,11,0.97);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 0.85rem 2rem 1rem;
    transform: translateY(100%);
    transition: transform .32s cubic-bezier(.32,.72,0,1);
  }
  .tts-player.tts-visible { transform: translateY(0); }
  .tts-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.55rem; }
  .tts-row1 { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .tts-badge { font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
  .tts-preview { font-size: 0.76rem; color: rgba(240,237,232,0.5); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 420px; flex: 1; text-align: right; }
  .tts-bar { width: 100%; height: 14px; cursor: pointer; display: flex; align-items: center; position: relative; }
  .tts-bar-track { width: 100%; height: 3px; background: rgba(255,255,255,0.15); border-radius: 3px; position: relative; overflow: visible; }
  .tts-fill { height: 100%; background: var(--accent); border-radius: 3px; transition: width .25s linear; width: 0%; position: relative; }
  .tts-fill::after { content: ''; position: absolute; right: -5px; top: 50%; transform: translateY(-50%) scale(0); width: 12px; height: 12px; border-radius: 50%; background: var(--accent); transition: transform .15s ease; }
  .tts-bar:hover .tts-fill::after, .tts-bar.dragging .tts-fill::after { transform: translateY(-50%) scale(1); }
  .tts-row2 { display: flex; align-items: center; gap: 0.75rem; }
  .tts-play { width: 34px; height: 34px; border-radius: 50%; background: var(--accent); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform .15s, opacity .15s; }
  .tts-play:hover { transform: scale(1.1); }
  .tts-play:active { opacity: 0.75; }
  .tts-play svg { width: 13px; height: 13px; fill: #fff; margin-left: 1px; }
  .tts-play.is-paused svg { margin-left: 0; }
  .tts-counter { font-size: 0.68rem; color: rgba(240,237,232,0.35); font-variant-numeric: tabular-nums; min-width: 3rem; }
  .tts-speeds { display: flex; gap: 0.3rem; margin-left: auto; }
  .tts-spd { padding: 0.18rem 0.48rem; border: 1px solid rgba(255,255,255,0.13); background: transparent; color: rgba(240,237,232,0.4); border-radius: 4px; font-size: 0.66rem; cursor: pointer; transition: border-color .15s, color .15s; font-family: var(--sans); }
  .tts-spd.active { border-color: var(--accent); color: var(--accent); }
  .tts-close { width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,0.07); border: none; color: rgba(240,237,232,0.45); font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s, color .15s; }
  .tts-close:hover { background: rgba(255,255,255,0.14); color: rgba(240,237,232,0.9); }
  @media (max-width: 640px) { .tts-player { padding: 0.75rem 1.2rem 0.9rem; } .tts-preview { display: none; } .tts-spd { padding: 0.18rem 0.4rem; font-size: 0.62rem; } }
  </style>
  <meta name="geo.region" content="VN" />
  <meta name="geo.placename" content="Vietnam" />
  <meta name="geo.position" content="14.0583;108.2772" />
  <meta name="ICBM" content="14.0583, 108.2772" />
  <script async src="/ga.js"></script>
</head>
<body>

  <div class="read-progress"><div class="read-progress-bar" id="progressBar"></div></div>

  <nav class="top-bar">
    <a href="/blog.html" class="back-link">Tech News</a>
    <span class="page-label">Bài viết</span>
  </nav>

  <article>
    <nav class="art-breadcrumb" aria-label="breadcrumb">
      <a href="/">Trang chủ</a>
      <span class="bc-sep">›</span>
      <a href="/blog.html">Tech News</a>
      <span class="bc-sep">›</span>
      <span>{category}</span>
    </nav>

    <div class="art-meta">
      <span class="cat">{category}</span>
      <span class="sep">·</span>
      <span>TechVision</span>
      <span class="sep">·</span>
      <span>{displayDate}</span>
      <span class="sep">·</span>
      <span>📖 <span id="readingTime">...</span></span>
    </div>

    <button class="tts-trigger" id="ttsTrigger" onclick="TTS.start()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
      </svg>
      Nghe bài viết
    </button>

    <h1 class="art-title">{title}</h1>

    <p class="art-deck">{deck}</p>

    <img class="art-hero" src={heroImage} alt={heroAlt || title} loading="eager" fetchpriority="high" width={isYtMaxres ? 1280 : undefined} height={isYtMaxres ? 720 : undefined} onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
    {heroCaption && <p class="art-hero-caption">{heroCaption}</p>}

    <div class="art-tldr">
      <div class="tldr-label">Tóm tắt nhanh</div>
      <p set:html={tldr}></p>
    </div>

    {tags.length > 0 && (
      <div class="art-tag-row">
        {tags.map((t) => <a href="#" class="art-tag">#{t}</a>)}
      </div>
    )}

    <div class="toc-box" id="toc">
      <div class="toc-header">
        <span class="toc-eyebrow">📋 Nội dung bài viết</span>
        <button class="toc-toggle">▲ Thu gọn</button>
      </div>
      <div class="toc-body"></div>
    </div>

    <div class="art-body">

      {stats.length > 0 && (
        <div class="art-stats">
          {stats.map((s) => (
            <div class="art-stat-card">
              <div class="stat-num">{s.num}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      )}

      <slot />

      {videos.map((v) => (
        <>
          {v.label && <div class="art-video-label">{v.label}</div>}
          <div class="art-video-wrap">
            <iframe
              src={`https://www.youtube.com/embed/${v.id}`}
              title={v.label || 'Video'}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen loading="lazy"></iframe>
          </div>
          {v.caption && <p class="art-video-caption">{v.caption}</p>}
        </>
      ))}

    </div>

    {faq.length > 0 && (
      <div class="art-faq">
        <div class="art-faq-label">Câu hỏi thường gặp</div>
        {faq.map((f) => (
          <div class="faq-item">
            <button class="faq-q" set:html={`${f.q} <span class="faq-icon">+</span>`}></button>
            <div class="faq-a" set:html={f.a}></div>
          </div>
        ))}
      </div>
    )}

    <div class="art-author-card">
      <img class="author-avatar" src="/uploads/favicon-avatar.jpg" alt="Nguyễn Tấn Thiên Long" loading="lazy" />
      <div class="author-info">
        <div class="author-name">Nguyễn Tấn Thiên Long</div>
        <div class="author-bio">{bio}</div>
        <div class="author-links">
          <a href="/cv.html">About</a>
          <a href="/blog.html">Tech News</a>
        </div>
      </div>
    </div>

    {sourceUrl && (
      <a href={sourceUrl} target="_blank" rel="noopener" class="source-card">
        <div class="source-card-label">Nguồn tham khảo</div>
        <div class="source-card-name">{sourceName}</div>
        <div class="source-card-url">{sourceDomains}</div>
      </a>
    )}

    <div class="share-section">
      <div class="share-label">Chia sẻ bài viết</div>
      <div class="share-buttons">
        <a href="#" data-share="facebook" class="share-btn" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 011-1h3v-4h-3a5 5 0 00-5 5v2.01h-2l-.396 3.98h2.396v8.01z"/></svg>
          Facebook
        </a>
        <a href="#" data-share="twitter" class="share-btn" aria-label="Share on X">
          <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X (Twitter)
        </a>
        <button data-share="copy" class="share-btn" aria-label="Copy link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
          Copy link
        </button>
        <button data-share="ai" class="share-btn" aria-label="Copy for AI">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.09 6.41L20.5 10l-6.41 2.09L12 22l-2.09-6.41L3.5 12l6.41-2.09z" opacity=".85"/><circle cx="12" cy="12" r="2"/></svg>
          Copy for AI
        </button>
      </div>
    </div>

    {related.length > 0 && (
      <div class="related-section">
        <div class="related-label">Bài liên quan</div>
        <div class="related-grid">
          {related.map((r) => (
            <a href={r.href} class="related-card">
              <div class="related-cat">{r.cat}</div>
              <div class="related-title">{r.title}</div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="comments-section" style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--line);">
