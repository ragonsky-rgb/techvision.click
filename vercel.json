{
  "framework": "astro",
  "buildCommand": "node scripts/build-legacy-index.mjs && node scripts/build-blog.mjs && astro build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.techvision.click" }],
      "destination": "https://techvision.click/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.techvision.click" }],
      "destination": "https://techvision.click/:path*",
      "permanent": true
    },
    {
      "source": "/articles/google-gemini-spark-tro-ly-ai-agentic-lam-viec-24-7-2026.html",
      "destination": "/articles/google-gemini-spark-tro-ly-ai-24-7-agentic-2026.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
