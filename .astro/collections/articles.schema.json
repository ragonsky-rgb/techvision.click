              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "href",
              "title"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "about": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "authorBio": {
          "type": "string"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "keywords",
        "datePublished",
        "deck",
        "heroImage",
        "tldr"
      ],
      "additionalProperties": false
