{
  "$ref": "#/definitions/articles",
  "definitions": {
    "articles": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "default": "AI"
        },
        "datePublished": {
          "type": "string"
        },
        "dateModified": {
          "type": "string"
        },
        "deck": {
          "type": "string"
        },
        "heroImage": {
          "type": "string"
        },
        "heroAlt": {
          "type": "string"
        },
        "heroCaption": {
          "type": "string"
        },
        "tldr": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "num": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "num",
              "label"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string"
              },
              "a": {
                "type": "string"
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "sourceUrl": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "sourceDomains": {
          "type": "string"
        },
        "related": {
          "type": "array",
